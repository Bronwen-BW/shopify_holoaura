{% comment %}
  Pixel Anime Card Archive home — retro 8-bit game UI aesthetic.
  Dark pixel-noir palette, Press Start 2P headings, pixel borders,
  HP/EXP bars, rarity tiers (N/R/SR/SSR/UR), daily check-in, leaderboard.
  All styles scoped under .px-home.
{% endcomment %}

<div class="px-home" style="{% render 'spacing-padding', settings: section.settings %}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">

<style>
.px-home{
  --px-bg:#0d0b1a;
  --px-bg-2:#14112b;
  --px-panel:#1a1636;
  --px-panel-2:#221d47;
  --px-line:#2e2656;
  --px-line-2:#3d3373;
  --px-text:#e8e6ff;
  --px-text-2:#9a94c7;
  --px-text-3:#5e5888;
  --px-pink:#ff2e88;
  --px-cyan:#00f0ff;
  --px-gold:#ffd600;
  --px-purple:#b14aed;
  --px-green:#00ff88;
  --px-red:#ff4757;
  --px-blue:#4a9eff;
  background:var(--px-bg);
  color:var(--px-text);
  font-family:"VT323", ui-monospace, "Courier New", monospace;
  font-size:18px;
  line-height:1.5;
  overflow:hidden;
  image-rendering:pixelated;
}
.px-home *, .px-home *::before, .px-home *::after{box-sizing:border-box}
.px-home a{color:inherit;text-decoration:none}
.px-home img{max-width:100%;display:block}
.px-home .px-wrap{max-width:1280px;margin:0 auto;padding:0 20px}
.px-home .px-font{font-family:"Press Start 2P", monospace}

/* pixel hard shadow helper */
.px-home .hard{box-shadow:0 0 0 2px #000, 6px 6px 0 0 rgba(0,0,0,.45)}
.px-home .hard-sm{box-shadow:0 0 0 2px #000, 4px 4px 0 0 rgba(0,0,0,.4)}

/* ===== TICKER ===== */
.px-home .ticker{
  background:#000;border-bottom:2px solid var(--px-pink);
  overflow:hidden;white-space:nowrap;
  font-family:"Press Start 2P",monospace;font-size:11px;
  color:var(--px-gold);padding:10px 0;
}
.px-home .ticker .in{display:inline-block;padding-left:100%;animation:px-scroll 28s linear infinite}
@keyframes px-scroll{to{transform:translateX(-100%)}}
.px-home .ticker span{margin-right:60px}
.px-home .ticker .p{color:var(--px-pink)} .px-home .ticker .c{color:var(--px-cyan)}

/* ===== HERO ===== */
.px-home .hero{
  position:relative;
  background:
    radial-gradient(60% 80% at 20% 20%, rgba(177,74,237,.25), transparent 60%),
    radial-gradient(50% 70% at 85% 70%, rgba(255,46,136,.22), transparent 60%),
    linear-gradient(180deg,#1a1240 0%, #0d0b1a 100%);
  padding:60px 0 70px;
  overflow:hidden;
}
.px-home .hero::before{
  content:"";position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
  background-size:32px 32px;
  pointer-events:none;
}
.px-home .hero .px-wrap{position:relative;z-index:1;display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center}
.px-home .hero .badge-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
.px-home .chip{
  font-family:"Press Start 2P",monospace;font-size:10px;
  padding:8px 12px;border:2px solid #000;background:var(--px-panel);
  color:var(--px-cyan);box-shadow:3px 3px 0 #000;
}
.px-home .chip.pk{color:var(--px-pink)} .px-home .chip.gd{color:var(--px-gold)}
.px-home .hero h1{
  font-family:"Press Start 2P",monospace;
  font-size:clamp(22px,4vw,42px);line-height:1.25;margin:0;
  color:#fff;text-shadow:4px 4px 0 var(--px-pink), 8px 8px 0 rgba(0,0,0,.5);
}
.px-home .hero h1 .c{color:var(--px-cyan)}
.px-home .hero p.lead{font-size:20px;color:var(--px-text-2);max-width:560px;margin:22px 0 0}
.px-home .hero p.lead b{color:var(--px-gold)}
.px-home .cta-row{display:flex;gap:16px;margin-top:30px;flex-wrap:wrap}
.px-home .pbtn{
  font-family:"Press Start 2P",monospace;font-size:13px;
  padding:14px 22px;border:2px solid #000;cursor:pointer;
  display:inline-flex;align-items:center;gap:10px;transition:transform .1s;
}
.px-home .pbtn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 #000}
.px-home .pbtn.pk{background:var(--px-pink);color:#fff;box-shadow:4px 4px 0 #7a0f44}
.px-home .pbtn.cy{background:var(--px-cyan);color:#001a1a;box-shadow:4px 4px 0 #007a8a}
.px-home .pbtn.ol{background:var(--px-panel);color:var(--px-text);box-shadow:4px 4px 0 #000}

/* hero player card */
.px-home .pcard{
  background:var(--px-panel);border:3px solid #000;
  box-shadow:8px 8px 0 rgba(0,0,0,.5);
  padding:18px;
}
.px-home .pcard .top{display:flex;justify-content:space-between;align-items:center;font-family:"Press Start 2P",monospace;font-size:10px;color:var(--px-gold)}
.px-home .pcard .avatar{
  width:100%;aspect-ratio:1;
  background:
    linear-gradient(135deg, var(--px-purple), var(--px-pink));
  border:2px solid #000;margin:14px 0;
  display:flex;align-items:center;justify-content:center;font-size:64px;
}
.px-home .bar{height:14px;background:#000;border:2px solid #000;position:relative;margin:6px 0 4px}
.px-home .bar .fill{height:100%}
.px-home .bar.hp .fill{width:78%;background:var(--px-green)}
.px-home .bar.mp .fill{width:54%;background:var(--px-blue)}
.px-home .bar.exp .fill{width:92%;background:var(--px-gold)}
.px-home .bar-label{display:flex;justify-content:space-between;font-size:14px;color:var(--px-text-2);font-family:"Press Start 2P",monospace;font-size:9px}

/* ===== SECTION HEAD ===== */
.px-home section{padding:56px 0}
.px-home .sec-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px}
.px-home .sec-head h2{
  font-family:"Press Start 2P",monospace;font-size:clamp(16px,2.4vw,22px);
  margin:0;color:#fff;line-height:1.3;
}
.px-home .sec-head h2 .blk{color:var(--px-pink)}
.px-home .sec-head .more{
  font-family:"Press Start 2P",monospace;font-size:10px;
  color:var(--px-cyan);border:2px solid var(--px-cyan);padding:8px 14px;
  background:transparent;box-shadow:3px 3px 0 #000;
}
.px-home .sec-head .more:hover{background:var(--px-cyan);color:#001a1a}

/* ===== BANNER STRIP (events) ===== */
.px-home .banners{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.px-home .banner{
  position:relative;border:3px solid #000;overflow:hidden;
  padding:22px;min-height:150px;display:flex;flex-direction:column;justify-content:flex-end;
  box-shadow:6px 6px 0 rgba(0,0,0,.5);
}
.px-home .banner .tag{
  position:absolute;top:12px;left:12px;
  font-family:"Press Start 2P",monospace;font-size:9px;
  padding:5px 9px;background:#000;color:var(--px-gold);
}
.px-home .banner.b1{background:linear-gradient(135deg,#b14aed,#ff2e88)}
.px-home .banner.b2{background:linear-gradient(135deg,#00f0ff,#4a9eff)}
.px-home .banner.b3{background:linear-gradient(135deg,#ffd600,#ff7a00)}
.px-home .banner h3{font-family:"Press Start 2P",monospace;font-size:14px;color:#fff;margin:0 0 8px;text-shadow:2px 2px 0 #000}
.px-home .banner p{margin:0;color:rgba(255,255,255,.9);font-size:16px}
.px-home .banner .count{
  margin-top:10px;font-family:"Press Start 2P",monospace;font-size:10px;
  background:rgba(0,0,0,.5);padding:6px 10px;display:inline-block;color:#fff;align-self:flex-start;
}

/* ===== RARITY TIERS ===== */
.px-home .rarities{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
.px-home .rar{
  border:3px solid #000;padding:18px 12px;text-align:center;
  background:var(--px-panel);box-shadow:5px 5px 0 rgba(0,0,0,.5);
  transition:transform .15s;
}
.px-home .rar:hover{transform:translateY(-4px)}
.px-home .rar .letter{font-family:"Press Start 2P",monospace;font-size:26px;margin-bottom:8px}
.px-home .rar .stars{color:var(--px-gold);letter-spacing:2px;font-size:14px}
.px-home .rar .desc{font-size:14px;color:var(--px-text-2);margin-top:6px}
.px-home .rar.n .letter{color:#9a94c7}
.px-home .rar.r .letter{color:var(--px-blue)}
.px-home .rar.sr .letter{color:var(--px-purple)}
.px-home .rar.ssr .letter{color:var(--px-gold)}
.px-home .rar.ur .letter{color:var(--px-pink);text-shadow:0 0 12px var(--px-pink)}

/* ===== CARD GRID ===== */
.px-home .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.px-home .card{
  background:var(--px-panel);border:3px solid #000;
  box-shadow:6px 6px 0 rgba(0,0,0,.5);
  display:flex;flex-direction:column;overflow:hidden;
  transition:transform .15s;
}
.px-home .card:hover{transform:translateY(-4px)}
.px-home .card .art{
  position:relative;aspect-ratio:3/4;border-bottom:3px solid #000;
  display:flex;align-items:center;justify-content:center;
  font-size:64px;
}
.px-home .card .art .glow{
  position:absolute;inset:0;
  background:radial-gradient(circle at 50% 40%, rgba(255,255,255,.18), transparent 65%);
}
.px-home .card .rar-tag{
  position:absolute;top:8px;left:8px;
  font-family:"Press Start 2P",monospace;font-size:9px;
  padding:4px 8px;color:#fff;border:2px solid #000;
}
.px-home .card .lvl{
  position:absolute;top:8px;right:8px;
  font-family:"Press Start 2P",monospace;font-size:9px;
  background:#000;color:var(--px-gold);padding:4px 8px;
}
.px-home .card.r-n .rar-tag{background:#6b6890}
.px-home .card.r-r .rar-tag{background:var(--px-blue)}
.px-home .card.r-sr .rar-tag{background:var(--px-purple)}
.px-home .card.r-ssr .rar-tag{background:var(--px-gold);color:#1a1205}
.px-home .card.r-ur .rar-tag{background:var(--px-pink)}
.px-home .card.r-n .art{background:linear-gradient(160deg,#2a2550,#1a1636)}
.px-home .card.r-r .art{background:linear-gradient(160deg,#1e3a6b,#142447)}
.px-home .card.r-sr .art{background:linear-gradient(160deg,#4a1e6b,#2a1447)}
.px-home .card.r-ssr .art{background:linear-gradient(160deg,#6b5a1e,#473a14)}
.px-home .card.r-ur .art{background:linear-gradient(160deg,#6b1e3a,#47142a)}
.px-home .card .info{padding:12px 14px 14px;display:flex;flex-direction:column;gap:8px;flex:1}
.px-home .card .cname{font-size:17px;font-weight:bold;color:#fff;line-height:1.25}
.px-home .card .cmeta{font-size:14px;color:var(--px-text-2)}
.px-home .card .cstats{display:flex;gap:10px;font-size:13px;font-family:"Press Start 2P",monospace;font-size:9px;color:var(--px-text-2)}
.px-home .card .cstats .hp{color:var(--px-green)} .px-home .card .cstats .at{color:var(--px-red)}
.px-home .card .buy{
  margin-top:auto;display:flex;justify-content:space-between;align-items:center;
  border-top:2px dashed var(--px-line-2);padding-top:10px;
}
.px-home .card .price{font-family:"Press Start 2P",monospace;font-size:13px;color:var(--px-gold)}
.px-home .card .buy-btn{
  font-family:"Press Start 2P",monospace;font-size:9px;
  background:var(--px-pink);color:#fff;border:2px solid #000;
  padding:7px 12px;cursor:pointer;box-shadow:3px 3px 0 #7a0f44;
}
.px-home .card .buy-btn:hover{background:var(--px-cyan);color:#001a1a;box-shadow:3px 3px 0 #007a8a}

/* ===== DECK / TWO-COLUMN ===== */
.px-home .two-col{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.px-home .panel{
  background:var(--px-panel);border:3px solid #000;
  box-shadow:6px 6px 0 rgba(0,0,0,.5);
}
.px-home .panel .panel-head{
  font-family:"Press Start 2P",monospace;font-size:12px;
  background:#000;color:var(--px-cyan);padding:12px 16px;
  border-bottom:3px solid #000;display:flex;justify-content:space-between;align-items:center;
}
.px-home .panel .panel-body{padding:18px}

/* daily check-in grid */
.px-home .checkin{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.px-home .day{
  aspect-ratio:1;border:2px solid var(--px-line-2);background:var(--px-bg-2);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  font-size:11px;color:var(--px-text-3);text-align:center;gap:2px;
}
.px-home .day .d{font-family:"Press Start 2P",monospace;font-size:8px}
.px-home .day .g{font-size:18px}
.px-home .day.done{background:#1d3a2a;border-color:var(--px-green);color:var(--px-green)}
.px-home .day.today{background:var(--px-pink);border-color:#000;color:#fff;animation:px-blink 1.2s infinite}
@keyframes px-blink{50%{opacity:.7}}
.px-home .day.today .d,.px-home .day.today .g{color:#fff}

/* leaderboard */
.px-home .lb-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:2px dashed var(--px-line-2)}
.px-home .lb-row:last-child{border-bottom:0}
.px-home .lb-rank{font-family:"Press Start 2P",monospace;font-size:12px;width:36px;text-align:center}
.px-home .lb-rank.r1{color:var(--px-gold)} .px-home .lb-rank.r2{color:#c0c0c0} .px-home .lb-rank.r3{color:#cd7f32}
.px-home .lb-ava{width:36px;height:36px;background:var(--px-panel-2);border:2px solid #000;display:flex;align-items:center;justify-content:center;font-size:18px}
.px-home .lb-name{flex:1;font-size:17px;color:#fff}
.px-home .lb-name small{display:block;color:var(--px-text-3);font-size:13px}
.px-home .lb-score{font-family:"Press Start 2P",monospace;font-size:11px;color:var(--px-cyan)}

/* ===== NEWS LIST ===== */
.px-home .news{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.px-home .news-item{
  background:var(--px-panel);border:3px solid #000;
  box-shadow:5px 5px 0 rgba(0,0,0,.5);padding:18px;
}
.px-home .news-item .ndate{font-family:"Press Start 2P",monospace;font-size:9px;color:var(--px-pink)}
.px-home .news-item h4{margin:10px 0 8px;font-size:19px;color:#fff}
.px-home .news-item p{margin:0;color:var(--px-text-2);font-size:15px}

/* ===== REVIEWS ===== */
.px-home .rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.px-home .rev{
  background:var(--px-panel);border:3px solid #000;
  box-shadow:5px 5px 0 rgba(0,0,0,.5);padding:20px;
}
.px-home .rev .stars{color:var(--px-gold);letter-spacing:2px}
.px-home .rev p{margin:10px 0 0;font-size:16px;color:var(--px-text)}
.px-home .rev .who{margin-top:10px;font-size:14px;color:var(--px-text-3)}

/* ===== CTA ===== */
.px-home .cta{
  position:relative;text-align:center;
  background:
    radial-gradient(60% 100% at 50% 0%, rgba(255,46,136,.3), transparent 70%),
    linear-gradient(180deg,#2a1447,#0d0b1a);
  border:3px solid var(--px-pink);
  box-shadow:0 0 0 3px #000, 8px 8px 0 rgba(0,0,0,.5);
  padding:60px 24px;
}
.px-home .cta h2{font-family:"Press Start 2P",monospace;font-size:clamp(16px,3vw,26px);margin:0;color:#fff;text-shadow:3px 3px 0 var(--px-pink)}
.px-home .cta p{color:var(--px-text-2);max-width:560px;margin:16px auto 0;font-size:18px}
.px-home .cta .sub-form{display:flex;gap:12px;max-width:480px;margin:26px auto 0}
.px-home .cta .sub-form input{
  flex:1;background:#000;border:2px solid var(--px-cyan);color:var(--px-text);
  padding:12px 16px;font-family:"VT323",monospace;font-size:18px;outline:none;
}
.px-home .cta .sub-form button{
  font-family:"Press Start 2P",monospace;font-size:12px;
  background:var(--px-cyan);color:#001a1a;border:2px solid #000;
  padding:0 22px;cursor:pointer;box-shadow:4px 4px 0 #007a8a;
}

/* ===== RESPONSIVE ===== */
@media (max-width:1024px){
  .px-home .hero .px-wrap{grid-template-columns:1fr}
  .px-home .cards{grid-template-columns:repeat(3,1fr)}
  .px-home .rarities{grid-template-columns:repeat(5,1fr)}
}
@media (max-width:768px){
  .px-home .banners,.px-home .two-col,.px-home .news,.px-home .rev-grid{grid-template-columns:1fr}
  .px-home .cards{grid-template-columns:repeat(2,1fr)}
  .px-home .rarities{grid-template-columns:repeat(3,1fr)}
  .px-home .checkin{grid-template-columns:repeat(4,1fr)}
  .px-home .cta .sub-form{flex-direction:column}
}
@media (max-width:480px){
  .px-home .cards{grid-template-columns:1fr}
  .px-home .rarities{grid-template-columns:repeat(2,1fr)}
  .px-home .checkin{grid-template-columns:repeat(3,1fr)}
}
</style>

  {% comment %} ===== TICKER ===== {% endcomment %}
  <div class="ticker">
