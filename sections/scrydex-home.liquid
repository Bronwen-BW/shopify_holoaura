{% comment %}
  AnimeHolder-style home section
  Content modelled on animeholder.com (extended art display cases), rendered in the
  dark, developer/terminal aesthetic. All styles scoped under .sc-home.
{% endcomment %}

<div class="sc-home" style="{% render 'spacing-padding', settings: section.settings %}">
  <style>
    .sc-home {
      --sc-bg: #09090b;
      --sc-panel: #111113;
      --sc-panel-2: #18181b;
      --sc-border: #26262b;
      --sc-border-soft: #1f1f23;
      --sc-text: #fafafa;
      --sc-text-2: #a1a1aa;
      --sc-text-3: #71717a;
      --sc-green: #22c55e;
      --sc-green-soft: rgba(34, 197, 94, 0.12);
      --sc-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
      --sc-rad: 14px;
      background: var(--sc-bg);
      color: var(--sc-text);
      font-family: inherit;
      line-height: 1.6;
      overflow: hidden;
    }
    .sc-home *, .sc-home *::before, .sc-home *::after { box-sizing: border-box; }
    .sc-home a { color: inherit; text-decoration: none; }
    .sc-home .sc-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    .sc-home section { padding: 80px 0; }
    .sc-home .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--sc-mono); font-size: 12px; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--sc-green);
      border: 1px solid var(--sc-border); border-radius: 999px;
      padding: 6px 14px; background: var(--sc-green-soft);
    }
    .sc-home h1, .sc-home h2, .sc-home h3 { margin: 0; line-height: 1.12; letter-spacing: -0.02em; font-weight: 700; }
    .sc-home .sc-hero-title { font-size: clamp(36px, 6.5vw, 68px); text-align: center; }
    .sc-home .sc-section-title { font-size: clamp(28px, 4vw, 44px); text-align: center; }
    .sc-home .sc-sub { color: var(--sc-text-2); font-size: clamp(15px, 1.6vw, 18px); text-align: center; max-width: 640px; margin: 18px auto 0; }
    .sc-home .sec-head { text-align: center; }
    .sc-home .sec-head .row { display:flex; align-items:baseline; justify-content:space-between; gap:16px; text-align:left; }
    .sc-home .sec-head .row .link { font-family: var(--sc-mono); font-size: 13px; color: var(--sc-text-2); border-bottom:1px solid var(--sc-border); padding-bottom:2px; white-space:nowrap; }
    .sc-home .sec-head .row .link:hover { color: var(--sc-green); border-color: var(--sc-green); }

    /* Buttons */
    .sc-home .sc-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 32px; }
    .sc-home .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 13px 26px; border-radius: 10px; font-weight: 600; font-size: 15px;
      transition: transform .15s ease, background .15s ease, border-color .15s ease;
      cursor: pointer; border: 1px solid transparent;
    }
    .sc-home .btn-primary { background: #fafafa; color: #09090b; }
    .sc-home .btn-primary:hover { transform: translateY(-1px); background: #fff; }
    .sc-home .btn-ghost { background: transparent; color: var(--sc-text); border-color: var(--sc-border); }
    .sc-home .btn-ghost:hover { border-color: #3f3f46; background: rgba(255,255,255,0.03); }

    /* Terminal window */
    .sc-home .term {
      background: var(--sc-panel); border: 1px solid var(--sc-border);
      border-radius: var(--sc-rad); overflow: hidden; box-shadow: 0 30px 80px -30px rgba(0,0,0,0.8);
    }
    .sc-home .term-bar {
      display: flex; align-items: center; gap: 8px;
      padding: 11px 16px; background: var(--sc-panel-2);
      border-bottom: 1px solid var(--sc-border);
      font-family: var(--sc-mono); font-size: 12.5px; color: var(--sc-text-3);
    }
    .sc-home .dot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
    .sc-home .dot.r { background: #ff5f57; } .sc-home .dot.y { background: #febc2e; } .sc-home .dot.g { background: #28c840; }
    .sc-home .term-title { margin-left: 10px; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sc-home .live { display: inline-flex; align-items: center; gap: 6px; font-family: var(--sc-mono); font-size: 11px; color: var(--sc-green); }
    .sc-home .live::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--sc-green); animation: sc-pulse 2s infinite; }
    @keyframes sc-pulse { 0%{box-shadow:0 0 0 0 rgba(34,197,94,.5);} 70%{box-shadow:0 0 0 7px rgba(34,197,94,0);} 100%{box-shadow:0 0 0 0 rgba(34,197,94,0);} }
    .sc-home .term-body { padding: 18px 20px; font-family: var(--sc-mono); font-size: 13px; line-height: 1.75; color: #d4d4d8; overflow-x: auto; }
    .sc-home .tk { color: #7dd3fc; } .sc-home .tk-key { color: #93c5fd; } .sc-home .tk-str { color: #86efac; }
    .sc-home .tk-num { color: #fbbf24; } .sc-home .tk-dim { color: var(--sc-text-3); }
    .sc-home .term-status { display:flex; justify-content: space-between; padding: 10px 20px; border-top: 1px solid var(--sc-border); font-family: var(--sc-mono); font-size: 12px; color: var(--sc-text-3); }
    .sc-home .term-status .ok { color: var(--sc-green); }

    /* Hero */
    .sc-home .sc-hero { padding-top: 64px; }
    .sc-home .sc-hero .term { margin-top: 52px; }

    /* Product cards */
    .sc-home .prod-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 40px; }
    .sc-home .prod {
      background: var(--sc-panel); border: 1px solid var(--sc-border); border-radius: var(--sc-rad);
      overflow: hidden; transition: border-color .15s ease, transform .15s ease; display: flex; flex-direction: column;
    }
    .sc-home .prod:hover { border-color: #3f3f46; transform: translateY(-2px); }
    .sc-home .prod .thumb {
      position: relative; aspect-ratio: 3/4; background:
        radial-gradient(120% 100% at 50% 0%, rgba(255,255,255,0.05), transparent 60%), var(--sc-panel-2);
      border-bottom: 1px solid var(--sc-border);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--sc-mono); color: var(--sc-text-3); font-size: 13px; letter-spacing: .05em;
    }
    .sc-home .prod .thumb .code { border: 1px solid var(--sc-border); border-radius: 8px; padding: 10px 14px; background: rgba(0,0,0,.25); }
    .sc-home .prod .flag {
      position: absolute; top: 10px; left: 10px; font-family: var(--sc-mono); font-size: 10px;
      letter-spacing: .08em; text-transform: uppercase; padding: 4px 9px; border-radius: 6px; font-weight: 700;
    }
    .sc-home .flag.hot { background: var(--sc-green); color: #04140a; }
    .sc-home .flag.best { background: #fafafa; color: #09090b; }
    .sc-home .flag.new { background: #fbbf24; color: #1a1205; }
    .sc-home .prod .info { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .sc-home .prod .pname { font-size: 13.5px; line-height: 1.4; color: var(--sc-text); }
    .sc-home .prod .pset { font-family: var(--sc-mono); font-size: 11px; color: var(--sc-text-3); }
    .sc-home .prod .pprice { margin-top: auto; padding-top: 8px; font-weight: 700; font-size: 16px; }

    /* Category grid */
    .sc-home .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 40px; }
    .sc-home .cat {
      display: block; background: var(--sc-panel); border: 1px solid var(--sc-border);
      border-radius: var(--sc-rad); overflow: hidden; transition: border-color .15s ease, transform .15s ease;
    }
    .sc-home .cat:hover { border-color: var(--sc-green); transform: translateY(-3px); }
    .sc-home .cat-img {
      position: relative; aspect-ratio: 4/3; overflow: hidden;
      border-bottom: 1px solid var(--sc-border);
      display: flex; align-items: center; justify-content: center;
    }
    .sc-home .cat-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
    .sc-home .cat:hover .cat-img img { transform: scale(1.05); }
    .sc-home .cat-ph {
      font-family: var(--sc-mono); font-size: 40px; font-weight: 700; color: rgba(255,255,255,0.85);
      text-shadow: 0 2px 12px rgba(0,0,0,.4);
    }
    /* Placeholder gradients (used when a collection has no image) */
    .sc-home .g-poke     { background: linear-gradient(135deg, #f7b733, #fc4a1a); }
    .sc-home .g-op       { background: linear-gradient(135deg, #e53935, #b71c1c); }
    .sc-home .g-lorcana  { background: linear-gradient(135deg, #6a11cb, #2575fc); }
    .sc-home .g-acc      { background: linear-gradient(135deg, #11998e, #38ef7d); }
    .sc-home .g-best     { background: linear-gradient(135deg, #f857a6, #ff5858); }
    .sc-home .g-new      { background: linear-gradient(135deg, #4b6cb7, #182848); }
    .sc-home .cat-name {
      padding: 16px 18px; font-weight: 600; font-size: 16px; text-align: center;
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .sc-home .cat-name::after { content: "\2192"; color: var(--sc-green); font-family: var(--sc-mono); transition: transform .15s ease; }
    .sc-home .cat:hover .cat-name::after { transform: translateX(3px); }

    /* Why / feature grid */
    .sc-home .feat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 48px; }
    .sc-home .feat-card {
      background: var(--sc-panel); border: 1px solid var(--sc-border); border-radius: var(--sc-rad); padding: 28px;
    }
    .sc-home .feat-card .fno { font-family: var(--sc-mono); font-size: 12px; color: var(--sc-green); }
    .sc-home .feat-card h3 { font-size: 20px; margin-top: 12px; }
    .sc-home .feat-card p { color: var(--sc-text-2); font-size: 14.5px; margin: 10px 0 0; }

    /* Reviews */
    .sc-home .rev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 48px; }
    .sc-home .rev {
      background: var(--sc-panel); border: 1px solid var(--sc-border); border-radius: var(--sc-rad); padding: 26px;
      display: flex; flex-direction: column; gap: 14px;
    }
    .sc-home .rev .stars { color: #fbbf24; letter-spacing: 2px; font-size: 15px; }
    .sc-home .rev p { color: var(--sc-text-2); font-size: 14.5px; margin: 0; flex: 1; }
    .sc-home .rev .who { font-family: var(--sc-mono); font-size: 12px; color: var(--sc-text-3); }

    /* Subscribe / CTA */
    .sc-home .sc-cta { text-align: center; }
    .sc-home .sc-cta .panel {
      background: radial-gradient(120% 160% at 50% 0%, rgba(34,197,94,0.12), var(--sc-panel) 60%);
      border: 1px solid var(--sc-border); border-radius: 20px; padding: 64px 24px;
    }
    .sc-home .sub-form { display: flex; gap: 10px; max-width: 480px; margin: 28px auto 0; }
    .sc-home .sub-form input {
      flex: 1; background: var(--sc-panel-2); border: 1px solid var(--sc-border); color: var(--sc-text);
      border-radius: 10px; padding: 13px 16px; font-size: 14px; outline: none;
    }
    .sc-home .sub-form input::placeholder { color: var(--sc-text-3); }
    .sc-home .sub-form input:focus { border-color: var(--sc-green); }

    @media (max-width: 900px) {
      .sc-home .prod-grid { grid-template-columns: repeat(2, 1fr); }
      .sc-home .cat-grid { grid-template-columns: repeat(2, 1fr); }
      .sc-home .feat-grid, .sc-home .rev-grid { grid-template-columns: 1fr; }
      .sc-home section { padding: 56px 0; }
    }
    @media (max-width: 560px) {
      .sc-home .prod-grid, .sc-home .cat-grid { grid-template-columns: 1fr; }
      .sc-home .sub-form { flex-direction: column; }
      .sc-home .sec-head .row { flex-direction: column; align-items: flex-start; gap: 4px; }
    }
  </style>

  {% comment %} ---------- HERO ---------- {% endcomment %}
  <section class="sc-hero">
    <div class="sc-wrap">
      <h1 class="sc-hero-title">Protect. Store. Display<br>Your Anime Collection.</h1>
      <p class="sc-sub">Premium card holders and display cases designed for serious collectors. Keep your treasures safe, organized, and beautifully showcased.</p>
      <div class="sc-btns">
        <a class="btn btn-primary" href="#best-seller">Explore now &rarr;</a>
        <a class="btn btn-ghost" href="#why">Why AnimeHolder</a>
      </div>
    </div>
  </section>

  {% comment %} ---------- CATEGORIES ---------- {% endcomment %}
  <section id="categories">
    <div class="sc-wrap">
      <div class="sec-head row">
        <h2 class="sc-section-title" style="text-align:left;">Shop by Category</h2>
        <a class="link" href="/collections/all">All categories &rarr;</a>
      </div>
      <div class="cat-grid">
        {%- if collections.all.size > 0 -%}
          {%- for collection in collections.all limit: 8 -%}
            <a class="cat" href="{{ collection.url }}">
              <div class="cat-img">
                {%- if collection.image -%}
                  <img src="{{ collection.image | image_url: width: 600, height: 750, crop: 'center' }}" alt="{{ collection.title | escape }}" loading="lazy">
                {%- else -%}
                  <span class="cat-ph">{{ collection.title | slice: 0, 1 }}</span>
                {%- endif -%}
              </div>
              <div class="cat-name">{{ collection.title }}</div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <a class="cat" href="/collections/pokemon">
            <div class="cat-img g-poke"><span class="cat-ph">P</span></div>
            <div class="cat-name">Pokémon</div>
          </a>
          <a class="cat" href="/collections/one-piece">
            <div class="cat-img g-op"><span class="cat-ph">OP</span></div>
            <div class="cat-name">One Piece</div>
          </a>
          <a class="cat" href="/collections/lorcana">
            <div class="cat-img g-lorcana"><span class="cat-ph">L</span></div>
            <div class="cat-name">Lorcana</div>
          </a>
          <a class="cat" href="/collections/accessories">
            <div class="cat-img g-acc"><span class="cat-ph">A</span></div>
            <div class="cat-name">Accessories</div>
          </a>
          <a class="cat" href="/collections/best-sellers">
            <div class="cat-img g-best"><span class="cat-ph">★</span></div>
            <div class="cat-name">Best Sellers</div>
          </a>
          <a class="cat" href="/collections/new">
            <div class="cat-img g-new"><span class="cat-ph">N</span></div>
            <div class="cat-name">New Arrivals</div>
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

