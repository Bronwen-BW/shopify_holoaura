{% comment %}
  RiPro-style dark home section.
  Layout modelled on ripro.rizhuti.com: search hero, live activity bar,
  category quick-entry cards, feature division, product grid with filter pills,
  reviews and subscribe CTA. All styles scoped under .rp-home.
{% endcomment %}

<div class="rp-home" style="{% render 'spacing-padding', settings: section.settings %}">
  <style>
    .rp-home {
      --rp-bg: #0b0f17;
      --rp-bg-2: #0f1522;
      --rp-card: #141c2b;
      --rp-card-2: #1a2334;
      --rp-border: #243049;
      --rp-border-soft: #1c2536;
      --rp-text: #e8ecf3;
      --rp-text-2: #9aa6b8;
      --rp-text-3: #6b7689;
      --rp-primary: #3b82f6;
      --rp-primary-2: #60a5fa;
      --rp-primary-soft: rgba(59,130,246,0.14);
      --rp-gold: #f59e0b;
      --rp-red: #ef4444;
      --rp-green: #10b981;
      --rp-rad: 14px;
      --rp-rad-sm: 10px;
      background: var(--rp-bg);
      color: var(--rp-text);
      line-height: 1.6;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .rp-home *, .rp-home *::before, .rp-home *::after { box-sizing: border-box; }
    .rp-home a { color: inherit; text-decoration: none; }
    .rp-home .rp-wrap { max-width: 1320px; margin: 0 auto; padding: 0 24px; }

    /* ---------- HERO / SEARCH ---------- */
    .rp-home .rp-hero {
      position: relative;
      padding: 96px 0 72px;
      text-align: center;
      background:
        radial-gradient(80% 120% at 50% -10%, rgba(59,130,246,0.35), transparent 60%),
        radial-gradient(50% 80% at 80% 20%, rgba(139,92,246,0.18), transparent 60%),
        linear-gradient(180deg, #0c1424 0%, #0b0f17 100%);
      overflow: hidden;
    }
    .rp-home .rp-hero::before {
      content: "";
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: radial-gradient(70% 60% at 50% 30%, #000 30%, transparent 100%);
      -webkit-mask-image: radial-gradient(70% 60% at 50% 30%, #000 30%, transparent 100%);
      pointer-events: none;
    }
    .rp-home .rp-hero > .rp-wrap { position: relative; z-index: 1; }
    .rp-home .rp-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 12.5px; letter-spacing: 0.08em;
      color: var(--rp-primary-2);
      background: var(--rp-primary-soft);
      border: 1px solid rgba(59,130,246,0.3);
      padding: 6px 14px; border-radius: 999px;
      margin-bottom: 22px;
    }
    .rp-home .rp-eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--rp-green); box-shadow: 0 0 0 4px rgba(16,185,129,0.18); }
    .rp-home .rp-hero h1 {
      font-size: clamp(34px, 5.6vw, 60px);
      line-height: 1.12; letter-spacing: -0.02em; font-weight: 800;
      margin: 0;
    }
    .rp-home .rp-hero h1 .grad {
      background: linear-gradient(90deg, var(--rp-primary-2), #a78bfa);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .rp-home .rp-hero p.sub {
      color: var(--rp-text-2); font-size: clamp(15px, 1.5vw, 17.5px);
      max-width: 620px; margin: 18px auto 0;
    }

    .rp-home .rp-search {
      display: flex; align-items: stretch;
      max-width: 680px; margin: 34px auto 0;
      background: var(--rp-card);
      border: 1px solid var(--rp-border);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 20px 60px -20px rgba(0,0,0,0.7);
    }
    .rp-home .rp-search input {
      flex: 1; background: transparent; border: 0; outline: none;
      color: var(--rp-text); font-size: 15px; padding: 0 20px; min-width: 0;
    }
    .rp-home .rp-search input::placeholder { color: var(--rp-text-3); }
    .rp-home .rp-search button {
      background: var(--rp-primary); border: 0; color: #fff;
      padding: 0 26px; font-size: 15px; font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
      transition: background .15s ease;
    }
    .rp-home .rp-search button:hover { background: #2563eb; }

    .rp-home .rp-hots { margin-top: 18px; font-size: 13px; color: var(--rp-text-3); }
    .rp-home .rp-hots .label { margin-right: 6px; }
    .rp-home .rp-hots a {
      color: var(--rp-text-2); margin: 0 8px;
      padding: 3px 10px; border-radius: 999px;
      background: var(--rp-card); border: 1px solid var(--rp-border-soft);
      transition: color .15s, border-color .15s;
    }
    .rp-home .rp-hots a:hover { color: var(--rp-primary-2); border-color: var(--rp-primary); }

    /* ---------- LIVE ACTIVITY BAR ---------- */
    .rp-home .rp-live {
      background: var(--rp-bg-2);
      border: 1px solid var(--rp-border-soft);
      border-radius: 12px;
      margin: -28px auto 0;
      position: relative; z-index: 2;
      display: flex; align-items: center; gap: 14px;
      padding: 12px 18px;
      max-width: 1320px;
    }
    .rp-home .rp-live .badge {
      flex-shrink: 0;
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--rp-card-2); color: var(--rp-text);
      font-size: 12.5px; font-weight: 600;
      padding: 6px 12px; border-radius: 8px;
    }
    .rp-home .rp-live .badge .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--rp-green); animation: rp-pulse 2s infinite; }
    @keyframes rp-pulse { 0%{box-shadow:0 0 0 0 rgba(16,185,129,.5);} 70%{box-shadow:0 0 0 7px rgba(16,185,129,0);} 100%{box-shadow:0 0 0 0 rgba(16,185,129,0);} }
    .rp-home .rp-live .items {
      flex: 1; overflow: hidden; white-space: nowrap;
      font-size: 13.5px; color: var(--rp-text-2);
    }
    .rp-home .rp-live .items span.u { color: var(--rp-text); font-weight: 600; margin: 0 4px; }
    .rp-home .rp-live .items span.t { color: var(--rp-text-3); margin-left: 10px; font-size: 12.5px; }

    /* ---------- SECTION HEAD ---------- */
    .rp-home section.rp-sec { padding: 64px 0; }
    .rp-home .sec-head { text-align: center; margin-bottom: 34px; }
    .rp-home .sec-head h2 {
      font-size: clamp(24px, 3.2vw, 34px); font-weight: 700;
      margin: 0; letter-spacing: -0.01em;
    }
    .rp-home .sec-head p { color: var(--rp-text-2); margin: 10px 0 0; font-size: 15px; }

    /* ---------- CATEGORY QUICK CARDS ---------- */
    .rp-home .rp-cats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
    .rp-home .rp-cat {
      position: relative; display: block; border-radius: var(--rp-rad);
      overflow: hidden; aspect-ratio: 4/3;
      border: 1px solid var(--rp-border-soft);
      transition: transform .2s ease, border-color .2s ease;
    }
    .rp-home .rp-cat:hover { transform: translateY(-3px); border-color: var(--rp-primary); }
    .rp-home .rp-cat .bg {
      position: absolute; inset: 0;
      background-size: cover; background-position: center;
      transition: transform .3s ease;
    }
    .rp-home .rp-cat:hover .bg { transform: scale(1.06); }
    .rp-home .rp-cat .shade {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(8,12,22,0.1) 0%, rgba(8,12,22,0.85) 100%);
    }
    .rp-home .rp-cat .meta { position: absolute; left: 14px; right: 14px; bottom: 12px; z-index: 2; }
    .rp-home .rp-cat .count {
      display: inline-block; font-size: 11px; font-weight: 700;
      background: rgba(255,255,255,0.16); backdrop-filter: blur(6px);
      color: #fff; padding: 3px 9px; border-radius: 6px; margin-bottom: 6px;
    }
    .rp-home .rp-cat .name { color: #fff; font-weight: 600; font-size: 15px; }

    /* gradient placeholders */
    .rp-home .g-poke    { background: linear-gradient(135deg, #f7b733, #fc4a1a); }
    .rp-home .g-op      { background: linear-gradient(135deg, #e53935, #7f1d1d); }
    .rp-home .g-lorcana { background: linear-gradient(135deg, #6a11cb, #2575fc); }
    .rp-home .g-acc     { background: linear-gradient(135deg, #11998e, #38ef7d); }
    .rp-home .g-best    { background: linear-gradient(135deg, #f857a6, #ff5858); }
    .rp-home .g-new     { background: linear-gradient(135deg, #4b6cb7, #182848); }

    /* ---------- FEATURE DIVISION ---------- */
    .rp-home .rp-div {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
      background: var(--rp-bg-2);
      border: 1px solid var(--rp-border-soft);
      border-radius: var(--rp-rad);
      padding: 28px 24px;
    }
    .rp-home .rp-div .item { display: flex; align-items: center; gap: 14px; }
    .rp-home .rp-div .ic {
      flex-shrink: 0; width: 46px; height: 46px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 18px;
    }
    .rp-home .rp-div h4 { margin: 0; font-size: 15px; font-weight: 600; }
    .rp-home .rp-div p { margin: 2px 0 0; font-size: 12.5px; color: var(--rp-text-3); }

    /* ---------- FILTER PILLS ---------- */
    .rp-home .rp-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 28px; }
    .rp-home .rp-pills a {
      font-size: 13px; padding: 7px 16px; border-radius: 999px;
      background: var(--rp-card); border: 1px solid var(--rp-border);
      color: var(--rp-text-2); transition: all .15s ease;
    }
    .rp-home .rp-pills a:hover { color: var(--rp-text); border-color: var(--rp-primary); }
    .rp-home .rp-pills a.active { background: var(--rp-primary); border-color: var(--rp-primary); color: #fff; }

    /* ---------- PRODUCT GRID ---------- */
    .rp-home .rp-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .rp-home .rp-pc {
      background: var(--rp-card);
      border: 1px solid var(--rp-border-soft);
      border-radius: var(--rp-rad);
      overflow: hidden;
      transition: transform .18s ease, border-color .18s ease;
      display: flex; flex-direction: column;
    }
    .rp-home .rp-pc:hover { transform: translateY(-3px); border-color: var(--rp-primary); }
    .rp-home .rp-pc .media {
      position: relative; aspect-ratio: 3/2;
      background: var(--rp-card-2);
      border-bottom: 1px solid var(--rp-border-soft);
      overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .rp-home .rp-pc .media img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
    .rp-home .rp-pc:hover .media img { transform: scale(1.05); }
    .rp-home .rp-pc .ph {
      font-size: 34px; font-weight: 800; color: rgba(255,255,255,0.85);
      letter-spacing: -0.02em;
    }
    .rp-home .rp-pc .flags { position: absolute; top: 10px; left: 10px; display: flex; gap: 6px; z-index: 2; }
    .rp-home .rp-pc .flag {
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em;
      padding: 4px 9px; border-radius: 6px; color: #fff;
    }
    .rp-home .flag.hot  { background: var(--rp-red); }
    .rp-home .flag.new  { background: var(--rp-gold); color: #1a1205; }
    .rp-home .flag.best { background: #1f2937; }
    .rp-home .rp-pc .body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .rp-home .rp-pc .cats { font-size: 11.5px; color: var(--rp-text-3); }
    .rp-home .rp-pc .cats a { color: var(--rp-text-3); }
    .rp-home .rp-pc .cats a + a::before { content: "·"; margin: 0 6px; }
    .rp-home .rp-pc .cats a:hover { color: var(--rp-primary-2); }
    .rp-home .rp-pc .pname {
      font-size: 14px; font-weight: 600; line-height: 1.4; color: var(--rp-text);
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .rp-home .rp-pc .pdesc {
      font-size: 12.5px; color: var(--rp-text-3);
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .rp-home .rp-pc .meta {
      margin-top: auto; padding-top: 10px;
      display: flex; align-items: center; justify-content: space-between;
      font-size: 12px; color: var(--rp-text-3);
      border-top: 1px dashed var(--rp-border-soft);
    }
    .rp-home .rp-pc .meta .price {
      color: var(--rp-primary-2); font-weight: 700; font-size: 15px;
    }
    .rp-home .rp-pc .meta .stats { display: flex; gap: 10px; }
    .rp-home .rp-pc .meta .stats span { display: inline-flex; align-items: center; gap: 4px; }

    /* ---------- REVIEWS ---------- */
    .rp-home .rp-rev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 8px; }
    .rp-home .rp-rev {
      background: var(--rp-card); border: 1px solid var(--rp-border-soft);
      border-radius: var(--rp-rad); padding: 24px;
      display: flex; flex-direction: column; gap: 12px;
    }
    .rp-home .rp-rev .stars { color: var(--rp-gold); letter-spacing: 2px; }
    .rp-home .rp-rev p { margin: 0; color: var(--rp-text-2); font-size: 14px; flex: 1; }
    .rp-home .rp-rev .who { font-size: 12.5px; color: var(--rp-text-3); }

    /* ---------- CTA ---------- */
    .rp-home .rp-cta .panel {
      position: relative;
      background:
        radial-gradient(80% 140% at 50% 0%, rgba(59,130,246,0.18), var(--rp-card) 65%);
      border: 1px solid var(--rp-border);
      border-radius: 20px;
      padding: 60px 24px; text-align: center;
    }
    .rp-home .rp-cta .panel h2 { font-size: clamp(24px, 3vw, 34px); margin: 14px 0 0; }
    .rp-home .rp-cta .panel p { color: var(--rp-text-2); max-width: 560px; margin: 12px auto 0; }
    .rp-home .rp-sub { display: flex; gap: 10px; max-width: 460px; margin: 26px auto 0; }
    .rp-home .rp-sub input {
      flex: 1; background: var(--rp-bg-2); border: 1px solid var(--rp-border);
      color: var(--rp-text); border-radius: 10px; padding: 13px 16px; font-size: 14px; outline: none;
    }
    .rp-home .rp-sub input:focus { border-color: var(--rp-primary); }
    .rp-home .rp-sub button {
      background: var(--rp-primary); color: #fff; border: 0;
      padding: 0 24px; border-radius: 10px; font-weight: 600; cursor: pointer;
    }
    .rp-home .rp-sub button:hover { background: #2563eb; }

    @media (max-width: 1100px) {
      .rp-home .rp-cats { grid-template-columns: repeat(3, 1fr); }
      .rp-home .rp-grid { grid-template-columns: repeat(3, 1fr); }
      .rp-home .rp-div { grid-template-columns: repeat(2, 1fr); gap: 22px; }
    }
    @media (max-width: 760px) {
      .rp-home .rp-cats { grid-template-columns: repeat(2, 1fr); }
      .rp-home .rp-grid { grid-template-columns: repeat(2, 1fr); }
      .rp-home .rp-rev-grid { grid-template-columns: 1fr; }
      .rp-home .rp-hero { padding: 64px 0 56px; }
      .rp-home section.rp-sec { padding: 48px 0; }
      .rp-home .rp-live { flex-direction: column; align-items: flex-start; gap: 8px; }
    }
    @media (max-width: 480px) {
      .rp-home .rp-grid, .rp-home .rp-cats { grid-template-columns: 1fr; }
      .rp-home .rp-sub { flex-direction: column; }
    }
  </style>

  {% comment %} ---------- HERO / SEARCH ---------- {% endcomment %}
  <section class="rp-hero">
    <div class="rp-wrap">
      <span class="rp-eyebrow"><span class="dot"></span> Premium Collector Store</span>
      <h1>Discover the Best <span class="grad">Extended Art</span><br>Card Display Cases</h1>
      <p class="sub">Premium holders and display cases designed for serious Pokémon, One Piece &amp; Lorcana collectors. Keep your treasures safe, organized, and beautifully showcased.</p>

      <form class="rp-search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" placeholder="Search cards, sets, characters..." aria-label="Search">
        <button type="submit"><i aria-hidden="true">&#128269;</i> Search</button>
      </form>

      <div class="rp-hots">
        <span class="label">Hot:</span>
        <a href="/collections/all">Pokémon</a>
        <a href="/collections/all">SIR SAR</a>
        <a href="/collections/all">Umbreon</a>
        <a href="/collections/all">Charizard</a>
        <a href="/collections/all">Lorcana</a>
      </div>
    </div>
  </section>

  {% comment %} ---------- LIVE ACTIVITY ---------- {% endcomment %}
  <div class="rp-wrap">
    <div class="rp-live">
      <span class="badge"><span class="pulse"></span> Live Activity</span>
      <div class="items">
        <span class="u">j***e</span> purchased <span>Mega Charizard X ex Display Case</span><span class="t">2 min ago</span>
        &nbsp;&nbsp;·&nbsp;&nbsp;
        <span class="u">m***a</span> reviewed <span>Umbreon SIR Case</span><span class="t">14 min ago</span>
        &nbsp;&nbsp;·&nbsp;&nbsp;
        <span class="u">p***k</span> added <span>Pikachu ex AHR-276</span> to cart<span class="t">31 min ago</span>
      </div>
    </div>
  </div>

  {% comment %} ---------- CATEGORY QUICK CARDS ---------- {% endcomment %}
  <section class="rp-sec">
    <div class="rp-wrap">
      <div class="rp-cats">
        {%- if collections.all.size > 0 -%}
          {%- for collection in collections.all limit: 5 -%}
            <a class="rp-cat" href="{{ collection.url }}">
              {%- if collection.image -%}
                <div class="bg" style="background-image:url('{{ collection.image | image_url: width: 600, height: 450, crop: 'center' }}')"></div>
              {%- else -%}
                <div class="bg g-poke"></div>
              {%- endif -%}
              <div class="shade"></div>
              <div class="meta">
                <span class="count">{{ collection.products_count }}+ items</span>
                <div class="name">{{ collection.title }}</div>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <a class="rp-cat" href="/collections/pokemon"><div class="bg g-poke"></div><div class="shade"></div><div class="meta"><span class="count">48+</span><div class="name">Pokémon</div></div></a>
          <a class="rp-cat" href="/collections/one-piece"><div class="bg g-op"></div><div class="shade"></div><div class="meta"><span class="count">24+</span><div class="name">One Piece</div></div></a>
          <a class="rp-cat" href="/collections/lorcana"><div class="bg g-lorcana"></div><div class="shade"></div><div class="meta"><span class="count">32+</span><div class="name">Lorcana</div></div></a>
          <a class="rp-cat" href="/collections/accessories"><div class="bg g-acc"></div><div class="shade"></div><div class="meta"><span class="count">18+</span><div class="name">Accessories</div></div></a>
          <a class="rp-cat" href="/collections/best-sellers"><div class="bg g-best"></div><div class="shade"></div><div class="meta"><span class="count">60+</span><div class="name">Best Sellers</div></div></a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {% comment %} ---------- FEATURE DIVISION ---------- {% endcomment %}
  <section class="rp-sec" style="padding-top:0;">
    <div class="rp-wrap">
      <div class="rp-div">
        <div class="item">
          <div class="ic" style="background:#8399ff;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></div>
          <div><h4>Modular Display</h4><p>Stack, sort &amp; expand your setup</p></div>
        </div>
        <div class="item">
          <div class="ic" style="background:#FF9800;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
          <div><h4>UV Protection</h4><p>Archival, fade-safe materials</p></div>
        </div>
        <div class="item">
          <div class="ic" style="background:#475569;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
          <div><h4>Magnetic Close</h4><p>Premium feel, ultra-clear front</p></div>
        </div>
        <div class="item">
          <div class="ic" style="background:#ff75a4;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4 2 7-6.5-4.5L5.5 20l2-7L2 9h7z"/></svg></div>
          <div><h4>Collector Drops</h4><p>New extended art weekly</p></div>
        </div>
      </div>
    </div>
  </section>

  {% comment %} ---------- LATEST PRODUCTS ---------- {% endcomment %}
  <section class="rp-sec" style="padding-top:0;">
    <div class="rp-wrap">
      <div class="sec-head">
        <h2>Latest Recommended</h2>
        <p>Freshly released extended art display cases, updated weekly for serious collectors.</p>
      </div>

      <div class="rp-pills">
        <a href="" class="active">Latest</a>
        <a href="/collections/pokemon">Pokémon</a>
        <a href="/collections/one-piece">One Piece</a>
        <a href="/collections/lorcana">Lorcana</a>
        <a href="/collections/accessories">Accessories</a>
        <a href="/collections/best-sellers">Best Sellers</a>
      </div>

      <div class="rp-grid">
        <a class="rp-pc" href="/products/mega-charizard-x-ex-display-case">
          <div class="media">
            <div class="flags"><span class="flag hot">HOT</span></div>
            <span class="ph">CHX</span>
