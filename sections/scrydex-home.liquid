        </div>
      </div>
    </div>
  </section>

  {% comment %} ===== RARITY TIERS ===== {% endcomment %}
  <section style="padding-top:0">
    <div class="px-wrap">
      <div class="sec-head">
        <h2>// RARITY <span class="blk">SYSTEM</span></h2>
        <a class="more" href="/collections/all">VIEW ALL →</a>
      </div>
      <div class="rarities">
        <div class="rar n"><div class="letter">N</div><div class="stars">★</div><div class="desc">Common<br>Base pulls</div></div>
        <div class="rar r"><div class="letter">R</div><div class="stars">★★</div><div class="desc">Rare<br>Skill cards</div></div>
        <div class="rar sr"><div class="letter">SR</div><div class="stars">★★★</div><div class="desc">Super Rare<br>Alt art</div></div>
        <div class="rar ssr"><div class="letter">SSR</div><div class="stars">★★★★</div><div class="desc">SSR<br>Holo foil</div></div>
