<script>
(function(){
  /* Hero carousel: auto-rotate, dots clickable, no arrows */
  document.querySelectorAll('[data-hero-carousel]').forEach(function(root){
    var slides = root.querySelectorAll('.car-slide');
    var dots = root.querySelectorAll('.car-dots .dot');
    if (!slides.length) return;
    var idx = 0, timer;
    function show(n){
      slides[idx].classList.remove('active');
      if (dots[idx]) dots[idx].classList.remove('active');
      idx = (n + slides.length) % slides.length;
      slides[idx].classList.add('active');
      if (dots[idx]) dots[idx].classList.add('active');
    }
    function start(){ timer = setInterval(function(){ show(idx+1); }, 3000); }
    dots.forEach(function(d, k){
      d.addEventListener('click', function(){ show(k); clearInterval(timer); start(); });
    });
    start();
  });

  /* Product carousels: scroll by one card width */
  document.querySelectorAll('.prod-wrap').forEach(function(wrap){
    var track = wrap.querySelector('.prod-track');
    var prev = wrap.querySelector('[data-prev]');
    var next = wrap.querySelector('[data-next]');
    if (!track) return;
    function step(){
      var card = track.querySelector('.prod');
      return card ? card.getBoundingClientRect().width + 20 : 300;
    }
    if (prev) prev.addEventListener('click', function(){ track.scrollBy({left:-step(), behavior:'smooth'}); });
    if (next) next.addEventListener('click', function(){ track.scrollBy({left:step(), behavior:'smooth'}); });
  });

  /* Category carousel */
  document.querySelectorAll('.cat-wrap').forEach(function(wrap){
    var track = wrap.querySelector('.cat-track');
    var prev = wrap.querySelector('[data-cat-prev]');
    var next = wrap.querySelector('[data-cat-next]');
    if (!track) return;
    function step(){
      var card = track.querySelector('.cat');
      return card ? card.getBoundingClientRect().width + 18 : 250;
    }
    if (prev) prev.addEventListener('click', function(){ track.scrollBy({left:-step(), behavior:'smooth'}); });
    if (next) next.addEventListener('click', function(){ track.scrollBy({left:step(), behavior:'smooth'}); });
  });
})();
</script>

