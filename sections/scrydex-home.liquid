{% comment %}
  Pixel Anime Card Display Case Shop — homepage section.
  Dark pixel/8-bit theme. Hero auto-carousel, horizontal product carousels,
  category tiles, features, reviews, newsletter CTA.
{% endcomment %}

{% assign best_coll = section.settings.best_collection | default: collections['best-sellers'] | default: collections.all %}
{% assign new_coll  = section.settings.new_collection  | default: collections['new-arrivals'] | default: collections['new'] | default: collections.all %}
{% assign hero_products = best_coll.products %}

<div class="px-shop" style="{% render 'spacing-padding', settings: section.settings %}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">

<style>
.px-shop{
  --bg:#0d0b1a; --panel:#1a1636; --panel2:#221d47;
  --line:#2e2656; --line2:#3d3373;
  --text:#e8e6ff; --text2:#9a94c7; --text3:#5e5888;
  --pink:#ff2e88; --cyan:#00f0ff; --gold:#ffd600;
  --red:#ff4757; --purple:#b14aed;
  background:var(--bg); color:var(--text);
  font-family:"VT323",ui-monospace,monospace; font-size:18px; line-height:1.5;
}
.px-shop *,.px-shop *::before,.px-shop *::after{box-sizing:border-box}
.px-shop a{color:inherit;text-decoration:none}
.px-shop img{max-width:100%;display:block}
.px-shop .wrap{max-width:1280px;margin:0 auto;padding:0 20px}

/* ── announcement ticker ── */
.px-shop .announce{background:#000;border-bottom:2px solid var(--pink);overflow:hidden;white-space:nowrap;font-family:"Press Start 2P",monospace;font-size:10px;color:var(--gold);padding:9px 0}
.px-shop .announce .in{display:inline-flex;animation:px-tick 30s linear infinite}
.px-shop .announce $160px}
@keyframes px-tick{to{transform:translateX(-50%)}}
.px-shop .announce .p{color:var(--pink)} .px-shop .announce .c{color:var(--cyan)}

/* ── hero ── */
.px-shop .hero{position:relative;background:radial-gradient(60% 80% at 25% 20%,rgba(177,74,237,.28),transparent 60%),radial-gradient(50% 70% at 85% 75%,rgba(255,46,136,.22),transparent 60%),linear-gradient(180deg,#1a1240,#0d0b1a);padding:64px 0 72px;overflow:hidden}
.px-shop .hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:32px 32px;pointer-events:none}
.px-shop .hero .wrap{position:relative;z-index:1;display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.px-shop .crumbs{display:inline-block;font-family:"Press Start 2P",monospace;font-size:10px;color:var(--cyan);background:var(--panel);border:2px solid #000;padding:8px 12px;box-shadow:3px 3px 0 #000;margin-bottom:20px}
.px-shop .hero h1{font-family:"Press Start 2P",monospace;font-size:clamp(20px,3.6vw,36px);line-height:1.3;margin:0;color:#fff;text-shadow:4px 4px 0 var(--pink),8px 8px 0 rgba(0,0,0,.5)}
.px-shop .hero h1 .c{color:var(--cyan)}
.px-shop .hero .lead{font-size:20px;color:var(--text2);max-width:560px;margin:22px 0 0}
.px-shop .hero .lead b{color:var(--gold)}
.px-shop .cta-row{display:flex;gap:14px;margin-top:30px;flex-wrap:wrap}
.px-shop .pbtn{font-family:"Press Start 2P",monospace;font-size:12px;padding:14px 22px;border:2px solid #000;display:inline-flex;align-items:center;gap:10px;transition:transform .1s}
.px-shop .pbtn:active{transform:translate(2px,2px)}
.px-shop .pbtn.pk{background:var(--pink);color:#fff;box-shadow:4px 4px 0 #7a0f44}
.px-shop .pbtn.cy{background:var(--cyan);color:#001a1a;box-shadow:4px 4px 0 #007a8a}

/* ── hero carousel (no arrows, dots only) ── */
.px-shop .carousel{background:var(--panel);border:3px solid #000;box-shadow:8px 8px 0 rgba(0,0,0,.5);padding:18px}
.px-shop .car-viewport{position:relative;aspect-ratio:1;overflow:hidden;border:3px solid #000;background:#000}
.px-shop .car-slide{position:absolute;inset:0;opacity:0;transition:opacity .5s;display:flex;align-items:center;justify-content:center}
.px-shop .car-slide.active{opacity:1}
.px-shop .car-slide img,.px-shop .car-slide .ph{width:100%;height:100%;object-fit:cover;display:flex;align-items:center;justify-content:center;font-size:80px}
.px-shop .car-slide .glow{position:absolute;inset:0;background:radial-gradient(circle at 50% 40%,rgba(255,255,255,.15),transparent 65%)}
.px-shop .car-dots{display:flex;gap:6px;justify-content:center;margin-top:12px}
.px-shop .car-dots .dot{width:10px;height:10px;background:var(--line2);border:1px solid #000;cursor:pointer}
.px-shop .car-dots .dot.active{background:var(--pink)}

/* ── section header ── */
.px-shop section{padding:56px 0}
.px-shop .sec-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px}
.px-shop .sec-head h2{font-family:"Press Start 2P",monospace;font-size:clamp(15px,2.2vw,20px);margin:0;color:#fff;line-height:1.3}
.px-shop .sec-head h2 .blk{color:var(--pink)}
.px-shop .sec-head .more{font-family:"Press Start 2P",monospace;font-size:10px;color:var(--cyan);border:2px solid var(--cyan);padding:8px 14px;box-shadow:3px 3px 0 #000}
.px-shop .sec-head .more:hover{background:var(--cyan);color:#001a1a}

/* ── category carousel (horizontal scroll) ── */
.px-shop .cat-wrap{position:relative}
.px-shop .cat-track{display:flex;gap:18px;overflow-x:auto;scroll-behavior:smooth;scrollbar-width:none;padding:4px 2px 12px}
.px-shop .cat-track::-webkit-scrollbar{display:none}
.px-shop .cat{position:relative;flex:0 0 calc((100% - 54px)/4);min-height:200px;display:flex;align-items:flex-end;overflow:hidden;border:3px solid #000;box-shadow:6px 6px 0 rgba(0,0,0,.5);transition:transform .15s}
.px-shop .cat:hover{transform:translateY(-4px)}
.px-shop .cat .cat-bg{position:absolute;inset:0;background-size:cover;background-position:center;transition:transform .3s}
.px-shop .cat:hover .cat-bg{transform:scale(1.06)}
.px-shop .cat.c1 .cat-bg{background:linear-gradient(135deg,#f7b733,#fc4a1a)}
.px-shop .cat.c2 .cat-bg{background:linear-gradient(135deg,#e53935,#7f1d1d)}
.px-shop .cat.c3 .cat-bg{background:linear-gradient(135deg,#6a11cb,#2575fc)}
.px-shop .cat.c4 .cat-bg{background:linear-gradient(135deg,#11998e,#38ef7d)}
.px-shop .cat.c5 .cat-bg{background:linear-gradient(135deg,#f5576c,#f093fb)}
.px-shop .cat.c6 .cat-bg{background:linear-gradient(135deg,#4facfe,#00f2fe)}
.px-shop .cat.c7 .cat-bg{background:linear-gradient(135deg,#43e97b,#38f9d7)}
.px-shop .cat.c8 .cat-bg{background:linear-gradient(135deg,#fa709a,#fee140)}
.px-shop .cat .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.82))}
.px-shop .cat .ct{position:relative;z-index:2;padding:18px;width:100%}
.px-shop .cat .ct h3{font-family:"Press Start 2P",monospace;font-size:13px;color:#fff;margin:0 0 6px;text-shadow:2px 2px 0 #000}
.px-shop .cat .ct p{margin:0;color:rgba(255,255,255,.85);font-size:15px}
.px-shop .cat .ct .cnt{display:inline-block;margin-top:8px;font-family:"Press Start 2P",monospace;font-size:9px;background:rgba(0,0,0,.6);padding:4px 8px;color:var(--gold)}

/* ── product carousel (horizontal scroll, rectangular cards) ── */
.px-shop .prod-wrap{position:relative}
.px-shop .prod-track{display:flex;gap:20px;overflow-x:auto;scroll-behavior:smooth;scrollbar-width:none;padding:4px 2px 12px}
.px-shop .prod-track::-webkit-scrollbar{display:none}
.px-shop .prod{position:relative;flex:0 0 calc((100% - 60px)/4);aspect-ratio:4/5;overflow:hidden;border:3px solid #000;background:var(--panel2);box-shadow:6px 6px 0 rgba(0,0,0,.5);transition:transform .15s;display:block}
.px-shop .prod:hover{transform:translateY(-4px)}
.px-shop .prod .pimg{position:absolute;inset:0}
.px-shop .prod .pimg img,.px-shop .prod .pimg .ph{width:100%;height:100%;object-fit:cover;display:flex;align-items:center;justify-content:center;font-size:72px}
.px-shop .prod .pimg img{transition:transform .3s}
.px-shop .prod:hover .pimg img{transform:scale(1.05)}
.px-shop .prod .tag{position:absolute;top:10px;left:10px;z-index:2;font-family:"Press Start 2P",monospace;font-size:9px;padding:5px 9px;color:#fff;border:2px solid #000}
.px-shop .prod .tag.hot{background:var(--red)}
.px-shop .prod .tag.new{background:var(--gold);color:#1a1205}
.px-shop .prod .tag.best{background:#000;color:var(--gold)}
.px-shop .prod .g1{background:linear-gradient(160deg,#3a1f5e,#1a1437)}
.px-shop .prod .g2{background:linear-gradient(160deg,#1e3a6b,#142447)}
.px-shop .prod .g3{background:linear-gradient(160deg,#5e1f3a,#37142a)}
.px-shop .prod .g4{background:linear-gradient(160deg,#5e4a1f,#372e14)}
/* hover overlay */
.px-shop .prod .info{position:absolute;left:0;right:0;bottom:0;z-index:3;padding:40px 14px 14px;background:linear-gradient(180deg,rgba(10,8,25,0),rgba(10,8,25,.92) 35%);transform:translateY(100%);transition:transform .28s;display:flex;flex-direction:column;gap:6px}
.px-shop .prod:hover .info,.px-shop .prod:focus-within .info{transform:translateY(0)}
.px-shop .prod .pname{font-size:17px;font-weight:bold;color:#fff;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.px-shop .prod .pseries{font-size:13px;color:var(--text2)}
.px-shop .prod .prow{margin-top:6px;display:flex;justify-content:space-between;align-items:center;border-top:2px dashed var(--line2);padding-top:8px}
.px-shop .prod .pprice{font-family:"Press Start 2P",monospace;font-size:13px;color:var(--gold)}
.px-shop .prod .padd{font-family:"Press Start 2P",monospace;font-size:10px;background:var(--pink);color:#fff;border:2px solid #000;padding:8px 13px;box-shadow:3px 3px 0 #7a0f44}
.px-shop .prod .padd:hover{background:var(--cyan);color:#001a1a}
/* product carousel nav buttons */
.px-shop .pnav{position:absolute;top:45%;transform:translateY(-50%);width:42px;height:42px;background:rgba(13,11,26,.9);border:3px solid #000;color:var(--gold);font-size:18px;cursor:pointer;z-index:5;display:flex;align-items:center;justify-content:center;font-family:"Press Start 2P",monospace;box-shadow:4px 4px 0 rgba(0,0,0,.6)}
.px-shop .pnav:hover{background:var(--pink);color:#fff}
.px-shop .pnav.prev{left:-21px}
.px-shop .pnav.next{right:-21px}

/* ── features ── */
.px-shop .feats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.px-shop .feat{background:var(--panel);border:3px solid #000;box-shadow:5px 5px 0 rgba(0,0,0,.5);padding:22px;text-align:center}
.px-shop .feat .fico{width:64px;height:64px;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;font-size:32px;background:var(--panel2);border:2px solid #000}
.px-shop .feat h4{font-family:"Press Start 2P",monospace;font-size:12px;color:#fff;margin:0 0 8px;line-height:1.4}
.px-shop .feat p{margin:0;color:var(--text2);font-size:15px}

/* ── reviews ── */
.px-shop .revs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.px-shop .rev{background:var(--panel);border:3px solid #000;box-shadow:5px 5px 0 rgba(0,0,0,.5);padding:20px}
.px-shop .rev .stars{color:var(--gold);letter-spacing:2px}
.px-shop .rev p{margin:10px 0 0;font-size:16px;color:var(--text)}
.px-shop .rev .who{margin-top:10px;font-size:14px;color:var(--text3)}

/* ── CTA ── */
.px-shop .cta{text-align:center;background:radial-gradient(60% 100% at 50% 0%,rgba(255,46,136,.3),transparent 70%),linear-gradient(180deg,#2a1447,#0d0b1a);border:3px solid var(--pink);box-shadow:0 0 0 3px #000,8px 8px 0 rgba(0,0,0,.5);padding:60px 24px}
.px-shop .cta h2{font-family:"Press Start 2P",monospace;font-size:clamp(15px,2.6vw,24px);margin:0;color:#fff;text-shadow:3px 3px 0 var(--pink)}
.px-shop .cta p{color:var(--text2);max-width:560px;margin:16px auto 0;font-size:18px}
.px-shop .cta .sub{display:flex;gap:12px;max-width:480px;margin:26px auto 0}
.px-shop .cta .sub input{flex:1;background:#000;border:2px solid var(--cyan);color:var(--text);padding:12px 16px;font-family:"VT323",monospace;font-size:18px;outline:none}
.px-shop .cta .sub button{font-family:"Press Start 2P",monospace;font-size:11px;background:var(--cyan);color:#001a1a;border:2px solid #000;padding:0 22px;cursor:pointer;box-shadow:4px 4px 0 #007a8a}

/* ── footer ── */
.px-shop footer{background:#08060f;border-top:3px solid var(--pink);padding:48px 0 24px}
.px-shop .fgrid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:36px}
.px-shop .fbrand h3{font-family:"Press Start 2P",monospace;font-size:16px;color:#fff;margin:0 0 12px}
.px-shop .fbrand h3 span{color:var(--pink)}
.px-shop .fbrand p{color:var(--text2);font-size:15px;margin:0 0 18px;max-width:320px}
.px-shop .fsocial{display:flex;gap:10px}
.px-shop .fsocial a{width:40px;height:40px;background:var(--panel);border:2px solid #000;display:flex;align-items:center;justify-content:center;font-size:18px;transition:background .15s}
.px-shop .fsocial a:hover{background:var(--pink)}
.px-shop .fcol h4{font-family:"Press Start 2P",monospace;font-size:11px;color:var(--gold);margin:0 0 14px}
.px-shop .fcol a{display:block;color:var(--text2);font-size:16px;padding:4px 0;transition:color .15s}
.px-shop .fcol a:hover{color:var(--cyan)}
.px-shop .fbottom{border-top:2px solid var(--line);margin-top:36px;padding-top:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.px-shop .fbottom small{color:var(--text3);font-size:14px}
.px-shop .fpays{display:flex;gap:8px;flex-wrap:wrap}
.px-shop .fpays span{font-family:"Press Start 2P",monospace;font-size:8px;background:var(--panel);border:2px solid #000;padding:5px 8px;color:var(--text2)}

/* ── responsive ── */
@media (max-width:1024px){
  .px-shop .hero .wrap{grid-template-columns:1fr}
  .px-shop .prod{flex:0 0 calc((100% - 40px)/3)}
  .px-shop .cat{flex:0 0 calc((100% - 36px)/3)}
}
@media (max-width:768px){
  .px-shop .prod{flex:0 0 calc((100% - 20px)/2)}
  .px-shop .cat{flex:0 0 calc((100% - 18px)/2)}
  .px-shop .feats,.px-shop .revs{grid-template-columns:1fr}
  .px-shop .cta .sub{flex-direction:column}
  .px-shop .fgrid{grid-template-columns:1fr 1fr}
  .px-shop .pnav.prev{left:4px}
  .px-shop .pnav.next{right:4px}
}
@media (max-width:480px){
  .px-shop .prod{flex:0 0 100%}
  .px-shop .cat{flex:0 0 80%}
  .px-shop .fgrid{grid-template-columns:1fr}
  .px-shop .fbottom{flex-direction:column;text-align:center}
}
</style>

  <!-- announcement ticker (content duplicated for seamless loop) -->
  <div class="announce">
    <div class="in">
      <span style="color:#ffd600;font-size:18px">新公告</span>
      <span style="color:#FF80C0;font-size:18px">新公告</span>
      <span style="color:Teal;font-size:18px">新公告</span>
      <span style="color:#ffd600;font-size:18px">新公告</span>
      <span style="color:#FF80C0;font-size:18px">新公告</span>
      <span style="color:Teal;font-size:18px">新公告</span>
    </div>
  </div>

  <!-- hero + featured carousel -->
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="crumbs">♦ HOME / EXTENDED ART DISPLAY CASES</span>
        <h1>PROTECT &amp;<span class="c">SHOWCASE</span><br>YOUR RARESTCARDS.</h1>
        <p class="lead">Ultra-clear extended-art display cases for Pok&#233;mon, One Piece &amp; Lorcana. Magnetic-close, UV-protected, built so your SIR / SAR cards look flawless.</p>
        <div class="cta-row">
          <a class="pbtn pk" href="#best-sellers">▶ SHOP BEST SELLERS</a>
          <a class="pbtn cy" href="#categories">▸ BROWSE CATEGORIES</a>
        </div>
      </div>

      <div class="carousel" data-hero-carousel>
        <div class="car-viewport">
          {%- if hero_products.size >= 1 -%}
            {%- for product in hero_products limit:4 -%}
              <div class="car-slide {% if forloop.first %}active{% endif %}">
                <div class="glow"></div>
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width:800, height:800, crop:'center' }}" alt="{{ product.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                  <span class="ph" style="display:none">🎴</span>
                {%- else -%}
                  <span class="ph">🎴</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="car-slide active" style="background:linear-gradient(160deg,#3a1f5e,#1a1437)"><div class="glow"></div><span class="ph">🔥</span></div>
            <div class="car-slide " style="background:linear-gradient(160deg,#1e3a6b,#142447)"><div class="glow"></div><span class="ph">🌙</span></div>
            <div class="car-slide " style="background:linear-gradient(160deg,#5e1f3a,#37142a)"><div class="glow"></div><span class="ph">✨</span></div>
            <div class="car-slide " style="background:linear-gradient(160deg,#5e4a1f,#372e14)"><div class="glow"></div><span class="ph">⚡</span></div>

          {%- endif -%}
        </div>
        <div class="car-dots">
          {%- if hero_products.size >= 1 -%}
            {%- for product in hero_products limit:4 -%}
              <span class="dot {% if forloop.first %}active{% endif %}" data-dot="{{ forloop.index0 }}"></span>
            {%- endfor -%}
          {%- else -%}
            <span class="dot active"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <!-- categories -->
  <section id="categories">
    <div class="wrap">
      <div class="sec-head">
        <h2>// SHOP BY <span class="blk">CATEGORY</span></h2>
        <a class="more" href="/collections/all">ALL →</a>
      </div>
      <div class="cat-wrap">
        <span class="pnav prev" data-cat-prev>‹</span>
        <div class="cat-track">
        {%- if collections.all.size > 0 -%}
          {%- for collection in collections.all limit:8 -%}
            <a class="cat c{{ forloop.index0 | modulo:8 | plus:1 }}" href="{{ collection.url }}">
              <div class="cat-bg" {% if collection.image %}style="background-image:url('{{ collection.image | image_url: width:800, height:500, crop:'center' }}')"{% endif %}></div>
              <div class="shade"></div>
              <div class="ct">
                <h3>{{ collection.title }}</h3>
                <p>Extended art &amp; display cases</p>
                <span class="cnt">{{ collection.products_count }}+ ITEMS</span>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <a class="cat" href="/collections/pokemon"><div class="cat-bg" style="background:linear-gradient(135deg,#F7B733,#FC4A1A)"></div><div class="shade"></div><div class="ct"><h3>Pok&#233;mon</h3><p>SIR / SAR display cases</p><span class="cnt">48+ ITEMS</span></div></a>
          <a class="cat" href="/collections/one-piece"><div class="cat-bg" style="background:linear-gradient(135deg,#e53935,#7f1d1d)"></div><div class="shade"></div><div class="ct"><h3>One Piece</h3><p>Manga &amp; OP card cases</p><span class="cnt">24+ ITEMS</span></div></a>
          <a class="cat" href="/collections/lorcana"><div class="cat-bg" style="background:linear-gradient(135deg,#6a11cb,#2575fc)"></div><div class="shade"></div><div class="ct"><h3>Lorcana</h3><p>Ravensburger TCG cases</p><span class="cnt">32+ ITEMS</span></div></a>
          <a class="cat" href="/collections/accessories"><div class="cat-bg" style="background:linear-gradient(135deg,#11998e,#38ef7d)"></div><div class="shade"></div><div class="ct"><h3>Accessories</h3><p>Sleeves, slabs, storage</p><span class="cnt">18+ ITEMS</span></div></a>
          <a class="cat" href="/collections/yugioh"><div class="cat-bg" style="background:linear-gradient(135deg,#f5576c,#f093fb)"></div><div class="shade"></div><div class="ct"><h3>Yu-Gi-Oh</h3><p>Rarity collection cases</p><span class="cnt">36+ ITEMS</span></div></a>
          <a class="cat" href="/collections/magic"><div class="cat-bg" style="background:linear-gradient(135deg,#4facfe,#00f2fe)"></div><div class="shade"></div><div class="ct"><h3>Magic: The Gathering</h3><p>MTG rare display cases</p><span class="cnt">22+ ITEMS</span></div></a>
          <a class="cat" href="/collections/digimon"><div class="cat-bg" style="background:linear-gradient(135deg,#43e97b,#38f9d7)"></div><div class="shade"></div><div class="ct"><h3>Digimon</h3><p>BT / EX series cases</p><span class="cnt">15+ ITEMS</span></div></a>
          <a class="cat" href="/collections/star-wars"><div class="cat-bg" style="background:linear-gradient(135deg,#fa709a,#fee140)"></div><div class="shade"></div><div class="ct"><h3>Star Wars</h3><p>Unlimited &amp; Vintage cases</p><span class="cnt">12+ ITEMS</span></div></a>

          {%- endif -%}
        </div>
