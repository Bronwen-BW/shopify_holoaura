{% comment %}
  RiPro-V5 dark home — 1:1 port of ripro.rizhuti.com homepage.
  Colors / radii / spacing taken directly from main.min.css dark theme:
    body-bg #1a1d24, card #21242b, border rgba(255,255,255,.04/.06),
    body-color #b0b5bd, emphasis #f8f9fb, muted #9499a5,
    primary #3b6ff5 (gradient to #3462d8), primary-text #89a9f9.
  Layout mirrors the real HTML: search hero + live dynamic bar +
  catbox quick entries + division feature row + post grid.
{% endcomment %}

<div class="ri-home" style="{% render 'spacing-padding', settings: section.settings %}">
<style>
.ri-home{
  /* RiPro dark theme tokens */
  --ri-body-bg:#1a1d24;
  --ri-body-color:#b0b5bd;
  --ri-emphasis:#f8f9fb;
  --ri-muted:#9499a5;
  --ri-card:#21242b;
  --ri-card-2:#1a1c23;
  --ri-border:rgba(255,255,255,.04);
  --ri-border-2:rgba(255,255,255,.06);
  --ri-primary:#3b6ff5;
  --ri-primary-2:#3462d8;
  --ri-primary-text:#89a9f9;
  --ri-primary-subtle:#0c1631;
  --ri-shadow:0 1px 3px rgba(0,0,0,.4);
  --ri-shadow-lg:0 4px 14px rgba(59,111,245,.35);
  --ri-radius:.5rem;
  --ri-radius-lg:.6rem;
  background:var(--ri-body-bg);
  color:var(--ri-body-color);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue","Noto Sans",Arial,sans-serif;
  font-size:.9375rem;
  font-weight:500;
  line-height:1.6;
  overflow:hidden;
}
.ri-home *, .ri-home *::before, .ri-home *::after{box-sizing:border-box}
.ri-home a{color:inherit;text-decoration:none}
.ri-home img{max-width:100%;display:block}
.ri-home .container{max-width:1320px;margin-left:auto;margin-right:auto;padding-left:15px;padding-right:15px}

/* ===== HERO SEARCH (home-search-box / search-bg) ===== */
.ri-home .search-box{position:relative;text-align:center;z-index:0;
  background:#1a66b2 radial-gradient(120% 120% at 50% 0%,#21abce 0%,#1a66b2 45%,#0f3a6b 100%);
  overflow:hidden;
}
.ri-home .search-box::before{
  content:"";position:absolute;inset:0;
  background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);
  background-size:48px 48px;
  mask-image:radial-gradient(70% 80% at 50% 40%,#000 20%,transparent 100%);
  -webkit-mask-image:radial-gradient(70% 80% at 50% 40%,#000 20%,transparent 100%);
  pointer-events:none;
}
.ri-home .search-overlay{
  position:absolute;inset:0;z-index:1;
  background:linear-gradient(135deg,rgba(25,27,38,.8),rgba(25,27,38,.6));
}
.ri-home .search-warp{position:relative;z-index:2;padding:120px 15px;max-width:1320px;margin:0 auto}
.ri-home .search-title{color:#fff;margin:0 0 .875rem;font-size:2rem;font-weight:700;line-height:1.25}
.ri-home .search-desc{color:rgba(255,255,255,.8);margin:0 0 1.5rem;font-size:1.05rem}
.ri-home .search-form{
  display:flex;align-items:stretch;max-width:680px;margin:0 auto;
  border-radius:var(--ri-radius-lg);background-color:var(--ri-card);
  border:1px solid var(--ri-border-2);
  box-shadow:0 2px 12px rgba(0,0,0,.3);overflow:hidden;
}
.ri-home .search-fields{flex:1 1 auto;display:flex;align-items:center;min-width:0}
.ri-home .search-fields input{
  flex:1;background:transparent;border:0;outline:0;color:var(--ri-body-color);
  font-size:1rem;padding:0 18px;height:52px;min-width:0;
}
.ri-home .search-fields input::placeholder{color:var(--ri-muted)}
.ri-home .search-form button{
  align-self:stretch;border:0;cursor:pointer;color:#fff;font-weight:600;font-size:.95rem;
  padding:0 26px;background:linear-gradient(135deg,#3b6ff5,#3462d8);
  box-shadow:0 4px 14px rgba(59,111,245,.35);
}
.ri-home .search-hots{margin-top:18px;font-size:.85rem;color:rgba(255,255,255,.65)}
.ri-home .search-hots .lbl{margin-right:6px}
.ri-home .search-hots a{color:#fff;margin:0 5px;padding:3px 10px;border-radius:.35rem;background:rgba(255,255,255,.12);transition:background .2s}
.ri-home .search-hots a:hover{background:rgba(255,255,255,.22)}

/* ===== LIVE DYNAMIC BAR ===== */
.ri-home .dyn-wrap{max-width:1320px;margin:-26px auto 0;padding:0 15px;position:relative;z-index:3}
.ri-home .dyn{
  display:flex;align-items:center;gap:14px;padding:10px 16px;
  background:rgba(176,181,189,.1);border-radius:.5rem;font-size:.875rem;
}
.ri-home .dyn .badge{
  display:inline-flex;align-items:center;gap:6px;flex-shrink:0;
  background:rgba(176,181,189,.18);color:#fff;font-weight:600;font-size:.8rem;
  padding:5px 10px;border-radius:.35rem;
}
.ri-home .dyn .badge .pulse{width:7px;height:7px;border-radius:50%;background:#2ecc71;animation:ri-pulse 2s infinite}
@keyframes ri-pulse{0%{box-shadow:0 0 0 0 rgba(46,204,113,.5)}70%{box-shadow:0 0 0 7px rgba(46,204,113,0)}100%{box-shadow:0 0 0 0 rgba(46,204,113,0)}}
.ri-home .dyn .feed{flex:1;overflow:hidden;white-space:nowrap;color:var(--ri-body-color)}
.ri-home .dyn .feed b{color:var(--ri-emphasis);font-weight:600;margin:0 3px}
.ri-home .dyn .feed .t{color:var(--ri-muted);margin-left:8px;font-size:.78rem}

/* ===== GENERIC SECTION ===== */
.ri-home section{margin:1.5rem 0}
.ri-home .section-title{text-align:center;margin-bottom:1.5rem}
.ri-home .section-title h3{margin:0;font-size:1.4rem;font-weight:600;color:var(--ri-emphasis)}
.ri-home .section-title p{margin:.4rem 0 0;color:var(--ri-muted);font-size:.9rem}

/* ===== CATBOX (home-cat-box) ===== */
.ri-home .catbox{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.ri-home .catbox-item{
  position:relative;height:120px;border-radius:var(--ri-radius);overflow:hidden;
  background-size:cover;background-position:center;text-align:center;
  display:flex;align-items:center;justify-content:center;
  transition:all .3s;
}
.ri-home .catbox-item:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.4)}
.ri-home .catbox-item .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.15),rgba(0,0,0,.55))}
.ri-home .catbox-item .inner{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;width:100%;padding:10px}
.ri-home .catbox-item .badge{
  display:inline-block;font-size:.75rem;font-weight:600;color:#fff;
  background:rgba(255,255,255,.18);backdrop-filter:blur(4px);
  padding:2px 8px;border-radius:.35rem;margin-bottom:6px;
}
.ri-home .catbox-item .cname{color:#fff;font-weight:600;letter-spacing:1px;font-size:1rem}
/* placeholder gradients (mirror ripro series-bg style) */
.ri-home .cb-g1{background:linear-gradient(135deg,#667eea,#764ba2)}
.ri-home .cb-g2{background:linear-gradient(135deg,#f093fb,#f5576c)}
.ri-home .cb-g3{background:linear-gradient(135deg,#4facfe,#00f2fe)}
.ri-home .cb-g4{background:linear-gradient(135deg,#43e97b,#38f9d7)}
.ri-home .cb-g5{background:linear-gradient(135deg,#fa709a,#fee140)}

/* ===== DIVISION FEATURE ROW ===== */
.ri-home .division{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.ri-home .division-item{
  display:flex;align-items:center;gap:14px;
  background-color:var(--ri-card);padding:.75rem;border-radius:var(--ri-radius);
  border:1px solid var(--ri-border);box-shadow:var(--ri-shadow);
  transition:all .3s;
}
.ri-home .division-item:hover{border-color:var(--ri-border-2)}
.ri-home .division-icon{
  flex-shrink:0;width:46px;height:46px;border-radius:var(--ri-radius);
  display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.2rem;
}
.ri-home .di-1{background:linear-gradient(135deg,#3b6ff5,#3b82f6)}
.ri-home .di-2{background:linear-gradient(135deg,#f093fb,#f5576c)}
.ri-home .di-3{background:linear-gradient(135deg,#4facfe,#00f2fe)}
.ri-home .di-4{background:linear-gradient(135deg,#43e97b,#38f9d7)}
.ri-home .division-warp{min-width:0}
.ri-home .division-title{font-size:1rem;font-weight:600;color:var(--ri-emphasis);margin:0 0 2px}
.ri-home .division-desc{margin:0;font-size:.82rem;color:var(--ri-muted)}

/* ===== FILTER PILLS (section-cat-navbtn) ===== */
.ri-home .cat-nav{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-bottom:1.5rem}
.ri-home .cat-nav a{
  display:inline-block;font-size:.85rem;font-weight:500;
  padding:6px 16px;border-radius:var(--ri-radius);
  background:var(--ri-card);border:1px solid var(--ri-border);color:var(--ri-body-color);
  transition:all .2s;
}
.ri-home .cat-nav a:hover{color:var(--ri-emphasis);border-color:var(--ri-border-2)}
.ri-home .cat-nav a.active{
  background:linear-gradient(135deg,#3b6ff5,#3462d8);color:#fff;border-color:transparent;
  box-shadow:0 4px 14px rgba(59,111,245,.35);
}

/* ===== POST GRID (posts-warp) ===== */
.ri-home .posts{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.ri-home .post-item{
  position:relative;display:flex;flex-direction:column;overflow:hidden;
  background-color:var(--ri-card);border-radius:var(--ri-radius);
  border:1px solid var(--ri-border);box-shadow:var(--ri-shadow);
  transition:all .3s;
}
.ri-home .post-item:hover{border-color:var(--ri-border-2);transform:translateY(-2px)}
.ri-home .post-media{position:relative;aspect-ratio:3/2;overflow:hidden;background:#0f1117}
.ri-home .post-media img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
.ri-home .post-item:hover .post-media img{transform:scale(1.05)}
.ri-home .post-media .ph{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:1.6rem;font-weight:700;color:rgba(255,255,255,.85);
}
.ri-home .post-flags{position:absolute;top:8px;left:8px;display:flex;gap:5px;z-index:2}
.ri-home .post-flags .flag{
  font-size:.7rem;font-weight:600;color:#fff;padding:3px 8px;border-radius:.35rem;
}
.ri-home .flag-hot{background:rgba(229,62,62,.85)}
.ri-home .flag-new{background:rgba(245,158,11,.85);color:#1a1205}
.ri-home .flag-best{background:rgba(20,22,28,.75)}
.ri-home .post-body{padding:12px;display:flex;flex-direction:column;flex:1;min-width:0}
.ri-home .post-cats{display:flex;align-items:center;margin-bottom:3px;font-size:.72rem;color:var(--ri-muted)}
.ri-home .post-cats a{color:var(--ri-muted)}
.ri-home .post-cats a+a::before{content:"·";margin:0 6px}
.ri-home .post-cats a:hover{color:var(--ri-primary-text)}
.ri-home .post-title{
  margin:0;font-size:.95rem;font-weight:600;color:var(--ri-emphasis);line-height:1.4;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all;
}
.ri-home .post-desc{
  color:var(--ri-muted);margin-top:4px;font-size:.75rem;line-height:1.35;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.ri-home .post-meta{
  display:flex;align-items:center;margin-top:8px;gap:10px;
  color:var(--ri-muted);font-size:.75rem;white-space:nowrap;letter-spacing:-.2px;
}
.ri-home .post-meta .price{color:var(--ri-primary-text);font-weight:700;font-size:.92rem;margin-left:auto}
.ri-home .post-meta .stat{display:inline-flex;align-items:center;gap:3px}

/* ===== REVIEWS ===== */
.ri-home .rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.ri-home .rev{
  background:var(--ri-card);border:1px solid var(--ri-border);border-radius:var(--ri-radius);
  padding:20px;box-shadow:var(--ri-shadow);
}
.ri-home .rev .stars{color:#f59e0b;letter-spacing:2px;font-size:.9rem}
.ri-home .rev p{margin:10px 0 0;color:var(--ri-body-color);font-size:.88rem}
.ri-home .rev .who{margin-top:10px;font-size:.78rem;color:var(--ri-muted)}

/* ===== CTA ===== */
.ri-home .cta-panel{
  position:relative;text-align:center;
  background:linear-gradient(135deg,rgba(59,111,245,.18),rgba(52,98,216,.08)),var(--ri-card);
  border:1px solid var(--ri-border);border-radius:var(--ri-radius-lg);
  padding:56px 24px;
}
.ri-home .cta-panel .eyebrow{
  display:inline-block;font-size:.78rem;color:var(--ri-primary-text);
  background:var(--ri-primary-subtle);border:1px solid rgba(59,111,245,.3);
  padding:5px 12px;border-radius:999px;
}
.ri-home .cta-panel h2{margin:14px 0 0;font-size:1.5rem;font-weight:600;color:var(--ri-emphasis)}
.ri-home .cta-panel p{margin:10px auto 0;max-width:540px;color:var(--ri-muted);font-size:.9rem}
.ri-home .sub-form{display:flex;gap:10px;max-width:440px;margin:24px auto 0}
.ri-home .sub-form input{
  flex:1;background:var(--ri-card-2);border:1px solid var(--ri-border-2);
  color:var(--ri-body-color);border-radius:var(--ri-radius);padding:11px 14px;font-size:.9rem;outline:none;
}
.ri-home .sub-form input:focus{border-color:var(--ri-primary)}
.ri-home .sub-form button{
  border:0;cursor:pointer;color:#fff;font-weight:600;padding:0 22px;border-radius:var(--ri-radius);
  background:linear-gradient(135deg,#3b6ff5,#3462d8);box-shadow:0 4px 14px rgba(59,111,245,.35);
}

/* ===== RESPONSIVE (mirror ripro breakpoints) ===== */
@media (max-width:1199px){
  .ri-home .posts{grid-template-columns:repeat(4,1fr)}
  .ri-home .catbox{grid-template-columns:repeat(5,1fr)}
}
@media (max-width:991px){
  .ri-home .search-warp{padding:70px 15px}
  .ri-home .search-title{font-size:1.5rem}
  .ri-home .division{grid-template-columns:repeat(2,1fr)}
  .ri-home .posts{grid-template-columns:repeat(3,1fr)}
  .ri-home .catbox{grid-template-columns:repeat(3,1fr)}
  .ri-home .rev-grid{grid-template-columns:1fr}
  .ri-home .dyn{flex-direction:column;align-items:flex-start}
}
@media (max-width:767px){
  .ri-home .posts{grid-template-columns:repeat(2,1fr)}
  .ri-home .catbox{grid-template-columns:repeat(2,1fr)}
  .ri-home .division{grid-template-columns:1fr}
  .ri-home .sub-form{flex-direction:column}
}
</style>

