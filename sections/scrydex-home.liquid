{% comment %}
  Pixel Anime Card Display CASE SHOP home — ecommerce, not a game.
  Pixel/8-bit visual skin applied to a conversion-focused storefront:
  announcement bar, hero product pitch, category tiles, best-seller
  product grid, feature selling points, new arrivals, reviews, CTA.
  All styles scoped under .px-shop.
{% endcomment %}

<div class="px-shop" style="{% render 'spacing-padding', settings: section.settings %}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">

<style>
.px-shop{
  --px-bg:#0d0b1a;
  --px-bg-2:#14112b;
  --px-panel:#1a1636;
  --px-panel-2:#221d47;
  --px-line:#2e2656;
  --px-line-2:#3d3373;
  --px-text:#e8e6ff;
  --px-text-2:#9a94c7;
  --px-text-3:#5e5888;
  --px-pink:#ff2e88;
  --px-cyan:#00f0ff;
  --px-gold:#ffd600;
  --px-purple:#b14aed;
  --px-green:#00ff88;
  --px-red:#ff4757;
  --px-blue:#4a9eff;
  background:var(--px-bg);
  color:var(--px-text);
  font-family:"VT323", ui-monospace, "Courier New", monospace;
  font-size:18px;line-height:1.5;overflow:hidden;
}
.px-shop *, .px-shop *::before, .px-shop *::after{box-sizing:border-box}
.px-shop a{color:inherit;text-decoration:none}
.px-shop img{max-width:100%;display:block}
.px-shop .wrap{max-width:1280px;margin:0 auto;padding:0 20px}

/* ===== ANNOUNCEMENT BAR ===== */
.px-shop .announce{
  background:#000;border-bottom:2px solid var(--px-pink);
  overflow:hidden;white-space:nowrap;
  font-family:"Press Start 2P",monospace;font-size:10px;
  color:var(--px-gold);padding:9px 0;
}
.px-shop .announce .in{display:inline-block;padding-left:100%;animation:px-scroll 30s linear infinite}
@keyframes px-scroll{to{transform:translateX(-100%)}}
.px-shop .announce span{margin-right:60px}
.px-shop .announce .p{color:var(--px-pink)} .px-shop .announce .c{color:var(--px-cyan)}

/* ===== HERO ===== */
.px-shop .hero{
  position:relative;
  background:
    radial-gradient(60% 80% at 25% 20%, rgba(177,74,237,.28), transparent 60%),
    radial-gradient(50% 70% at 85% 75%, rgba(255,46,136,.22), transparent 60%),
    linear-gradient(180deg,#1a1240 0%, #0d0b1a 100%);
  padding:64px 0 72px;overflow:hidden;
}
.px-shop .hero::before{
  content:"";position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
  background-size:32px 32px;pointer-events:none;
}
.px-shop .hero .wrap{position:relative;z-index:1;display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:center}
.px-shop .hero .crumbs{
  display:inline-block;font-family:"Press Start 2P",monospace;font-size:10px;
  color:var(--px-cyan);background:var(--px-panel);border:2px solid #000;
  padding:8px 12px;box-shadow:3px 3px 0 #000;margin-bottom:20px;
}
.px-shop .hero h1{
  font-family:"Press Start 2P",monospace;
  font-size:clamp(20px,3.8vw,38px);line-height:1.3;margin:0;
  color:#fff;text-shadow:4px 4px 0 var(--px-pink), 8px 8px 0 rgba(0,0,0,.5);
}
.px-shop .hero h1 .c{color:var(--px-cyan)}
.px-shop .hero p.lead{font-size:20px;color:var(--px-text-2);max-width:560px;margin:22px 0 0}
.px-shop .hero p.lead b{color:var(--px-gold)}
.px-shop .cta-row{display:flex;gap:14px;margin-top:30px;flex-wrap:wrap}
.px-shop .pbtn{
  font-family:"Press Start 2P",monospace;font-size:12px;
  padding:14px 22px;border:2px solid #000;cursor:pointer;
  display:inline-flex;align-items:center;gap:10px;transition:transform .1s;
}
.px-shop .pbtn:active{transform:translate(2px,2px)}
.px-shop .pbtn.pk{background:var(--px-pink);color:#fff;box-shadow:4px 4px 0 #7a0f44}
.px-shop .pbtn.cy{background:var(--px-cyan);color:#001a1a;box-shadow:4px 4px 0 #007a8a}

/* hero product mockup — pixel display case */
.px-shop .showcase{
  position:relative;background:var(--px-panel);border:3px solid #000;
  box-shadow:8px 8px 0 rgba(0,0,0,.5);padding:24px;
}
.px-shop .showcase .sw-head{
  display:flex;justify-content:space-between;font-family:"Press Start 2P",monospace;font-size:9px;
  color:var(--px-gold);margin-bottom:14px;
}
.px-shop .showcase .case{
  position:relative;aspect-ratio:3/4;
  background:linear-gradient(160deg,#2a1f5e,#14112b);
  border:3px solid #000;overflow:hidden;
}
.px-shop .showcase .case .card-art{
  position:absolute;inset:14px;
  background:linear-gradient(135deg,#ff2e88 0%,#b14aed 60%,#4a9eff 100%);
  border:2px solid rgba(255,255,255,.25);
  display:flex;align-items:center;justify-content:center;font-size:72px;
}
.px-shop .showcase .case .shine{
  position:absolute;top:0;left:0;width:40%;height:100%;
  background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.18) 50%,transparent 70%);
}
.px-shop .showcase .sw-foot{
  display:flex;justify-content:space-between;align-items:center;
  margin-top:14px;font-family:"Press Start 2P",monospace;font-size:10px;
}
.px-shop .showcase .sw-foot .price{color:var(--px-gold);font-size:13px}
.px-shop .showcase .sw-foot .badge{color:var(--px-green)}

/* ===== SECTION HEAD ===== */
.px-shop section{padding:56px 0}
.px-shop .sec-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px}
.px-shop .sec-head h2{
  font-family:"Press Start 2P",monospace;font-size:clamp(15px,2.2vw,20px);
  margin:0;color:#fff;line-height:1.3;
}
.px-shop .sec-head h2 .blk{color:var(--px-pink)}
.px-shop .sec-head .more{
  font-family:"Press Start 2P",monospace;font-size:10px;
  color:var(--px-cyan);border:2px solid var(--px-cyan);padding:8px 14px;
  box-shadow:3px 3px 0 #000;
}
.px-shop .sec-head .more:hover{background:var(--px-cyan);color:#001a1a}

/* ===== CATEGORY TILES ===== */
.px-shop .cats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.px-shop .cat{
  position:relative;border:3px solid #000;min-height:180px;
  display:flex;flex-direction:column;justify-content:flex-end;
  padding:18px;overflow:hidden;box-shadow:6px 6px 0 rgba(0,0,0,.5);
  transition:transform .15s;
}
.px-shop .cat:hover{transform:translateY(-4px)}
.px-shop .cat .ic{position:absolute;top:14px;right:16px;font-size:40px;opacity:.9}
.px-shop .cat h3{font-family:"Press Start 2P",monospace;font-size:13px;color:#fff;margin:0 0 6px;text-shadow:2px 2px 0 #000}
.px-shop .cat p{margin:0;color:rgba(255,255,255,.85);font-size:15px}
.px-shop .cat .cnt{
  display:inline-block;margin-top:8px;font-family:"Press Start 2P",monospace;font-size:9px;
  background:rgba(0,0,0,.5);padding:4px 8px;align-self:flex-start;color:var(--px-gold);
}
.px-shop .cat.c1{background:linear-gradient(135deg,#f7b733,#fc4a1a)}
.px-shop .cat.c2{background:linear-gradient(135deg,#e53935,#7f1d1d)}
.px-shop .cat.c3{background:linear-gradient(135deg,#6a11cb,#2575fc)}
.px-shop .cat.c4{background:linear-gradient(135deg,#11998e,#38ef7d)}

/* ===== PRODUCT GRID ===== */
.px-shop .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.px-shop .prod{
  background:var(--px-panel);border:3px solid #000;
  box-shadow:6px 6px 0 rgba(0,0,0,.5);
  display:flex;flex-direction:column;overflow:hidden;
  transition:transform .15s;
}
.px-shop .prod:hover{transform:translateY(-4px)}
.px-shop .prod .img{
  position:relative;aspect-ratio:1;
  display:flex;align-items:center;justify-content:center;font-size:72px;
  border-bottom:3px solid #000;
}
.px-shop .prod .img .tag{
  position:absolute;top:10px;left:10px;
  font-family:"Press Start 2P",monospace;font-size:9px;
  padding:5px 9px;color:#fff;border:2px solid #000;
}
.px-shop .prod .img .tag.hot{background:var(--px-red)}
.px-shop .prod .img .tag.new{background:var(--px-gold);color:#1a1205}
.px-shop .prod .img .tag.best{background:#000;color:var(--px-gold)}
.px-shop .prod .i1{background:linear-gradient(160deg,#3a1f5e,#1a1437)}
.px-shop .prod .i2{background:linear-gradient(160deg,#1e3a6b,#142447)}
.px-shop .prod .i3{background:linear-gradient(160deg,#5e1f3a,#37142a)}
.px-shop .prod .i4{background:linear-gradient(160deg,#5e4a1f,#372e14)}
.px-shop .prod .info{padding:14px 16px 16px;display:flex;flex-direction:column;gap:8px;flex:1}
.px-shop .prod .name{font-size:18px;font-weight:bold;color:#fff;line-height:1.3;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.px-shop .prod .series{font-size:14px;color:var(--px-text-3)}
.px-shop .prod .row{
  margin-top:auto;display:flex;justify-content:space-between;align-items:center;
  border-top:2px dashed var(--px-line-2);padding-top:10px;
}
.px-shop .prod .price{font-family:"Press Start 2P",monospace;font-size:13px;color:var(--px-gold)}
.px-shop .prod .price s{color:var(--px-text-3);font-size:10px;margin-right:6px}
.px-shop .prod .add{
  font-family:"Press Start 2P",monospace;font-size:10px;
  background:var(--px-pink);color:#fff;border:2px solid #000;
  padding:8px 13px;cursor:pointer;box-shadow:3px 3px 0 #7a0f44;
}
.px-shop .prod .add:hover{background:var(--px-cyan);color:#001a1a;box-shadow:3px 3px 0 #007a8a}

/* ===== FEATURES ===== */
.px-shop .feats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.px-shop .feat{
  background:var(--px-panel);border:3px solid #000;
  box-shadow:5px 5px 0 rgba(0,0,0,.5);padding:22px;text-align:center;
}
.px-shop .feat .fico{
  width:64px;height:64px;margin:0 auto 14px;
  display:flex;align-items:center;justify-content:center;font-size:32px;
  background:var(--px-panel-2);border:2px solid #000;
}
.px-shop .feat h4{font-family:"Press Start 2P",monospace;font-size:12px;color:#fff;margin:0 0 8px;line-height:1.4}
.px-shop .feat p{margin:0;color:var(--px-text-2);font-size:15px}

/* ===== REVIEWS ===== */
.px-shop .revs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.px-shop .rev{
  background:var(--px-panel);border:3px solid #000;
  box-shadow:5px 5px 0 rgba(0,0,0,.5);padding:20px;
}
.px-shop .rev .stars{color:var(--px-gold);letter-spacing:2px}
.px-shop .rev p{margin:10px 0 0;font-size:16px;color:var(--px-text)}
.px-shop .rev .who{margin-top:10px;font-size:14px;color:var(--px-text-3)}

/* ===== CTA ===== */
.px-shop .cta{
  position:relative;text-align:center;
  background:
    radial-gradient(60% 100% at 50% 0%, rgba(255,46,136,.3), transparent 70%),
    linear-gradient(180deg,#2a1447,#0d0b1a);
  border:3px solid var(--px-pink);
  box-shadow:0 0 0 3px #000, 8px 8px 0 rgba(0,0,0,.5);
  padding:60px 24px;
}
.px-shop .cta h2{font-family:"Press Start 2P",monospace;font-size:clamp(15px,2.6vw,24px);margin:0;color:#fff;text-shadow:3px 3px 0 var(--px-pink)}
.px-shop .cta p{color:var(--px-text-2);max-width:560px;margin:16px auto 0;font-size:18px}
.px-shop .cta .sub{display:flex;gap:12px;max-width:480px;margin:26px auto 0}
.px-shop .cta .sub input{
  flex:1;background:#000;border:2px solid var(--px-cyan);color:var(--px-text);
  padding:12px 16px;font-family:"VT323",monospace;font-size:18px;outline:none;
}
.px-shop .cta .sub button{
  font-family:"Press Start 2P",monospace;font-size:11px;
  background:var(--px-cyan);color:#001a1a;border:2px solid #000;
  padding:0 22px;cursor:pointer;box-shadow:4px 4px 0 #007a8a;
}

/* ===== RESPONSIVE ===== */
@media (max-width:1024px){
  .px-shop .hero .wrap{grid-template-columns:1fr}
  .px-shop .grid{grid-template-columns:repeat(3,1fr)}
  .px-shop .cats{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:768px){
  .px-shop .grid{grid-template-columns:repeat(2,1fr)}
  .px-shop .feats,.px-shop .revs{grid-template-columns:1fr}
  .px-shop .cta .sub{flex-direction:column}
}
@media (max-width:480px){
  .px-shop .grid,.px-shop .cats{grid-template-columns:1fr}
}
</style>

