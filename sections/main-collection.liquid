

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<style>
/* ============ 商品系列页 · 像素风皮肤（本样式仅 collection 模板输出） ============ */
:root{
  --pxbg:#0d0b1a; --pxpanel:#1a1636; --pxpanel2:#221d47;
  --pxtext:#e8e6ff; --pxtext2:#9a94c7;
  --pxpink:#ff2e88; --pxcyan:#00f0ff; --pxgold:#ffd600;
}
body{background:#0d0b1a !important;font-family:"VT323",ui-monospace,monospace;}
.section-background,
results-list.product-grid-container,
.collection-wrapper{background:#0d0b1a !important;color:var(--pxtext);}
/* 本页去圆角（本样式仅系列页输出） */
body *{border-radius:0 !important;}

/* —— 顶部系列标题 / 描述（居中、缩小） —— */
.text-block h1{
  font-family:"Press Start 2P",monospace !important;
  font-size:clamp(13px,1.9vw,21px) !important;line-height:1.5 !important;
  color:#fff !important;margin:0 auto 14px;text-align:center !important;word-break:break-word;
  text-shadow:3px 3px 0 var(--pxpink),6px 6px 0 rgba(0,0,0,.5);
}
.text-block.rte,
.text-block p{color:var(--pxtext2) !important;font-family:"VT323",monospace !important;font-size:18px !important;line-height:1.55 !important;text-align:center;}

/* —— 商品卡（复刻首页 .prod：4:5 卡牌、图铺满、hover 底部浮层） —— */
.product-grid__item{display:block;transition:transform .15s;}
.product-grid__item:hover{transform:translateY(-4px);}
.px-card{
  --pxpink:#ff2e88;--pxcyan:#00f0ff;--pxgold:#ffd600;--pxtext2:#9a94c7;
  position:relative;display:block;width:100%;aspect-ratio:4/5;
  background:linear-gradient(160deg,#3a1f5e,#1a1437);
  border:3px solid #000;box-shadow:6px 6px 0 rgba(0,0,0,.5);
  overflow:hidden;text-decoration:none !important;color:#fff !important;
  -webkit-text-stroke:0;text-shadow:none;
}
.px-card,.px-card *{box-sizing:border-box;-webkit-text-stroke:0;}
.px-card__media{position:absolute;inset:0;display:block;background:linear-gradient(160deg,#3a1f5e,#1a1437);}
.px-card__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s;}
.px-card:hover .px-card__media img{transform:scale(1.05);}
.px-card__ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:72px;line-height:1;filter:drop-shadow(3px 3px 0 rgba(0,0,0,.5));}
.px-card__tag{position:absolute;top:10px;left:10px;z-index:2;font-family:"Press Start 2P",monospace;font-size:9px;line-height:1;padding:5px 9px;color:#fff !important;border:2px solid #000 !important;box-shadow:3px 3px 0 rgba(0,0,0,.45);letter-spacing:1px;text-shadow:none;}
.px-card__tag--sale{background:#ffd600 !important;color:#1a1205 !important;}
.px-card__tag--out{background:#ff2e88 !important;color:#fff !important;}
.px-card__info{
  position:absolute;left:0;right:0;bottom:0;z-index:3;padding:40px 14px 14px;
  display:flex;flex-direction:column;gap:6px;
  background:linear-gradient(180deg,rgba(10,8,25,0),rgba(10,8,25,.92) 35%);
  transform:translateY(100%);transition:transform .28s;
}
.px-card:hover .px-card__info,.px-card:focus-within .px-card__info{transform:translateY(0);}
.px-card__name{font-family:"VT323",monospace;font-size:18px;font-weight:bold;color:#fff !important;line-height:1.25;text-shadow:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.px-card__type{font-family:"VT323",monospace;font-size:14px;line-height:1.2;color:#9a94c7 !important;text-shadow:none;}
.px-card__row{margin-top:6px;display:flex;justify-content:space-between;align-items:center;gap:8px;border-top:2px dashed #2e2656;padding-top:8px;}
.px-card__price{display:flex;flex-direction:column;gap:3px;line-height:1.2;min-width:0;}
.px-card__cmp,.px-card__cmp *{font-family:"Press Start 2P",monospace !important;font-size:9px !important;color:#9a94c7 !important;text-decoration:line-through !important;text-shadow:none;}
.px-card__now,.px-card__now *{font-family:"Press Start 2P",monospace !important;font-size:13px !important;color:#ffd600 !important;white-space:nowrap;text-shadow:none;}
.px-card__view{font-family:"Press Start 2P",monospace !important;font-size:10px !important;background:#ff2e88 !important;color:#fff !important;border:2px solid #000 !important;padding:8px 12px;box-shadow:3px 3px 0 #7a0f44;white-space:nowrap;text-shadow:none;transition:background .12s,color .12s;}
.px-card:hover .px-card__view{background:#00f0ff !important;color:#001a1a !important;box-shadow:3px 3px 0 #007a8a;}
/* 触屏（无 hover）：信息常驻，保证标题价格可见 */
@media (hover:none){
  .px-card__info{transform:translateY(0);padding-top:32px;}
}
/* zoom-out 缩略视图：只留图块，占位符缩小 */
ul[product-grid-view="zoom-out"] .px-card__info,
ul[product-grid-view="zoom-out"] .px-card__tag{display:none;}
ul[product-grid-view="zoom-out"] .px-card__ph{font-size:34px;}
/* 快速加购 / 通用按钮 */
.button,
button.button,
.facets-toggle__button{
  font-family:"Press Start 2P",monospace !important;font-size:11px !important;
  border:2px solid #000 !important;box-shadow:4px 4px 0 rgba(0,0,0,.5) !important;
  text-transform:uppercase;letter-spacing:.5px;padding:12px 18px !important;
  transition:transform .1s, box-shadow .1s;
}
.button--primary,
.facets-toggle__button{background:var(--pxcyan) !important;color:#001a1a !important;}
.button--secondary{background:var(--pxpanel) !important;color:var(--pxgold) !important;}
.quick-add__button,
.quick-add button{background:var(--pxpink) !important;color:#fff !important;}
.button:hover,
.facets-toggle__button:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 rgba(0,0,0,.5) !important;}

/* —— 筛选 / 排序 —— */
.facets,
.facets *{color:var(--pxtext);}
.facets__filters-title,
.facets__heading,
.facets-vertical__heading,
.facets-drawer__title{
  font-family:"Press Start 2P",monospace !important;font-size:12px !important;color:var(--pxgold) !important;
}
.facets__clear-all-link{font-family:"Press Start 2P",monospace !important;font-size:9px !important;color:var(--pxcyan) !important;}
.facets-toggle__wrapper{border:2px solid #000 !important;}
.select__select,
select,
.facets__selected,
input[type="text"],
input[type="search"]{
  background:var(--pxpanel) !important;color:var(--pxtext) !important;
  border:2px solid #000 !important;border-radius:0 !important;
  font-family:"VT323",monospace !important;font-size:18px !important;
}
.facets-block-wrapper,
.facets--drawer{background:var(--pxpanel) !important;color:var(--pxtext);}

/* —— 横向筛选工具条容器 —— */
.facets--horizontal .facets__form{
  background:linear-gradient(180deg,#1d1840 0%,#15122f 100%) !important;
  border:2px solid #000 !important;border-radius:0 !important;
  box-shadow:inset 2px 2px 0 rgba(255,255,255,.06),4px 4px 0 rgba(0,0,0,.45) !important;
  padding:13px 15px !important;align-items:center;
}
/* —— 筛选 / 排序 触发按钮（横向：立体凸起像素按钮） —— */
.facets--horizontal .facets__summary{
  position:relative;display:inline-flex !important;align-items:center;gap:8px;
  background:linear-gradient(180deg,#2c2560 0%,#1b1640 100%) !important;
  color:#ffd600 !important;border:2px solid #000 !important;border-radius:0 !important;
  box-shadow:inset 2px 2px 0 rgba(255,255,255,.16),inset -2px -2px 0 rgba(0,0,0,.5),3px 3px 0 rgba(0,0,0,.55) !important;
  padding:12px 15px !important;margin:2px;min-height:0 !important;cursor:pointer;list-style:none;
  font-family:"Press Start 2P","Microsoft JhengHei","微軟正黑體",monospace !important;
  font-size:11px !important;font-weight:700;letter-spacing:.5px;line-height:1;white-space:nowrap;text-transform:uppercase;
  transition:transform .08s,box-shadow .08s,background .12s,border-color .12s,color .12s;
}
.facets__summary::-webkit-details-marker{display:none;}
.facets--horizontal .facets__summary .facets__label{color:inherit !important;font:inherit !important;letter-spacing:.5px;}
.facets--horizontal .facets__summary:hover{
  background:linear-gradient(180deg,#372f78 0%,#221b50 100%) !important;
  border-color:#00f0ff !important;color:#00f0ff !important;transform:translate(-1px,-1px);
  box-shadow:inset 2px 2px 0 rgba(255,255,255,.2),inset -2px -2px 0 rgba(0,0,0,.5),4px 4px 0 rgba(0,0,0,.55) !important;
}
.facets--horizontal details[open] > .facets__summary,
.facets--horizontal .facets__summary:active{
  background:linear-gradient(180deg,#14102b 0%,#1d1840 100%) !important;
  border-color:#ff2e88 !important;color:#ff2e88 !important;transform:translate(2px,2px);
  box-shadow:inset 2px 2px 0 rgba(0,0,0,.6),inset -2px -2px 0 rgba(255,255,255,.07),1px 1px 0 rgba(0,0,0,.4) !important;
}
.facets__summary .icon-caret{color:inherit !important;width:12px;height:12px;transition:transform .2s;}
details[open] > .facets__summary .icon-caret{transform:rotate(180deg);}
.facets__summary .facets__status{
  color:#00f0ff !important;font-family:"VT323",monospace !important;font-size:16px !important;font-weight:400;
}
.facets__summary .facets__bubble{
  background:#ff2e88 !important;color:#fff !important;border:1px solid #000 !important;border-radius:0 !important;
  font-family:"Press Start 2P",monospace !important;font-size:9px !important;line-height:1;
  min-width:17px;height:17px;padding:0 4px;display:inline-flex;align-items:center;justify-content:center;
}
/* —— 筛选 / 排序 弹层（不带 section 前缀，兼容浮层被传送至 body） —— */
.facets__inputs.facets__panel-content,
.sorting-filter__options{
  background:linear-gradient(180deg,#1d1840 0%,#15122f 100%) !important;
  border:3px solid #000 !important;border-radius:0 !important;
  box-shadow:inset 2px 2px 0 rgba(255,255,255,.08),6px 6px 0 rgba(0,0,0,.55) !important;
  color:#e8e6ff !important;padding:13px !important;min-width:218px;z-index:60;
}
.facets__inputs .facets__header,
.facets__inputs fieldset,
.facets__inputs li{border-color:#2e2656 !important;}
.facets__inputs label,
.sorting-filter__label{
  font-family:"Microsoft JhengHei","微軟正黑體","VT323",monospace !important;
  font-size:16px !important;font-weight:700;color:#e8e6ff !important;
  display:flex;align-items:center;gap:10px;padding:7px 9px;margin:1px 0;cursor:pointer;
  border-left:3px solid transparent;line-height:1.2;
}
.facets__inputs label:hover,
.sorting-filter__option:hover{background:#221d47 !important;}
.facets__inputs label:hover{border-left-color:#00f0ff !important;color:#00f0ff !important;}
.sorting-filter__option:hover{border-left:3px solid #00f0ff;}
.sorting-filter__option:hover .sorting-filter__label{color:#00f0ff !important;}
/* 像素勾选框 */
.facets__inputs input[type="checkbox"],
.facets__inputs input[type="radio"],
.sorting-filter__input{
  appearance:none;-webkit-appearance:none;flex:0 0 15px;width:15px !important;height:15px !important;margin:0 !important;
  background:#0d0b1a !important;border:2px solid #000 !important;border-radius:0 !important;
  box-shadow:inset 1px 1px 0 rgba(255,255,255,.14),1px 1px 0 rgba(0,0,0,.5);cursor:pointer;
}
.facets__inputs input:checked,
.sorting-filter__input:checked{background:#00f0ff !important;box-shadow:inset 0 0 0 2px #0d0b1a,1px 1px 0 rgba(0,0,0,.5) !important;}
.facets__inputs input:checked ~ *{color:#ff2e88 !important;}
.sorting-filter__input:checked ~ .sorting-filter__label{color:#ff2e88 !important;}
.facets__inputs input[type="number"],
.price-filter__input{
  background:#0d0b1a !important;border:2px solid #000 !important;border-radius:0 !important;
  color:#e8e6ff !important;font-family:"VT323",monospace !important;font-size:17px !important;padding:6px 8px;
}
.facets__inputs .button,
.facets__inputs button{border-radius:0 !important;}
/* —— 商品计数 / 网格密度 —— */
.products-count-wrapper,
.products-count-wrapper span{
  font-family:"Press Start 2P",monospace !important;font-size:10px !important;color:#9a94c7 !important;letter-spacing:.5px;
}
.grid-density-controls button,
[class*="grid-density"] button{
  background:linear-gradient(180deg,#2c2560,#1b1640) !important;border:2px solid #000 !important;border-radius:0 !important;
  color:#9a94c7 !important;box-shadow:inset 1px 1px 0 rgba(255,255,255,.14),inset -1px -1px 0 rgba(0,0,0,.45),2px 2px 0 rgba(0,0,0,.5);
  padding:8px !important;cursor:pointer;transition:background .12s,color .12s;
}
.grid-density-controls button[aria-pressed="true"],
[class*="grid-density"] button[aria-pressed="true"],
.grid-density-controls button:hover,
[class*="grid-density"] button:hover{
  color:#00f0ff !important;background:linear-gradient(180deg,#372f78,#221b50) !important;
}
.grid-density-controls .icon,
[class*="grid-density"] .icon{color:inherit;width:16px;height:16px;}
/* 移动端排序 select 兜底 */
.sorting-filter__select{
  background:#1a1636 !important;color:#e8e6ff !important;border:2px solid #000 !important;
  border-radius:0 !important;font-family:"VT323",monospace !important;font-size:17px !important;padding:8px;
}

/* —— 空结果 —— */
.main-collection-grid__empty{
  background:var(--pxpanel) !important;border:3px solid #000 !important;
  box-shadow:6px 6px 0 rgba(0,0,0,.5) !important;color:var(--pxtext);
}
.main-collection-grid__empty-title{
  font-family:"Press Start 2P",monospace !important;color:#fff !important;
  text-shadow:3px 3px 0 var(--pxpink);
}
/* —— 编号分页（像素方块，点击页码切换） —— */
.pagination{padding:28px 8px 10px;}
.pagination__list{gap:6px;}
.pagination__item{width:auto !important;aspect-ratio:auto !important;min-width:42px;height:42px;}
.pagination__link{
  font-family:"Press Start 2P",monospace !important;font-size:11px !important;font-weight:400;
  background:var(--pxpanel) !important;color:var(--pxgold) !important;
  border:2px solid #000 !important;border-radius:0 !important;box-shadow:3px 3px 0 rgba(0,0,0,.5);
  width:42px;height:42px;display:grid;place-items:center;
  transition:background .12s,color .12s,transform .08s;
}
.pagination__link::before{display:none !important;content:none !important;}
.pagination__link:hover:not(.pagination__link--disabled):not(.pagination__link--gap){
  background:var(--pxpanel2) !important;color:var(--pxcyan) !important;transform:translate(-1px,-1px);
}
.pagination__link--current{background:var(--pxpink) !important;color:#fff !important;}
.pagination__link--gap{background:transparent !important;border-color:transparent !important;box-shadow:none;color:var(--pxtext2) !important;}
.pagination__link--disabled{background:var(--pxpanel) !important;color:#5e5888 !important;opacity:.55;box-shadow:2px 2px 0 rgba(0,0,0,.4);}
.pagination__link svg{width:10px;height:14px;color:inherit;}
@media screen and (max-width:749px){
  .pagination{padding:20px 4px 8px;}
  .pagination__item{min-width:38px;height:38px;}
  .pagination__link{width:38px;height:38px;font-size:10px;}
}
/* 焦点 */
a:focus-visible,
button:focus-visible{outline:3px solid var(--pxcyan) !important;outline-offset:2px;}
</style>

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
        {% for product in collection.products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            <a class="px-card{% if product.available == false %} is-soldout{% endif %}" href="{{ product.url }}">
              <span class="px-card__media">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 640 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  <span class="px-card__ph" aria-hidden="true">🎴</span>
                {%- endif -%}
                {%- if product.available == false -%}
                  <span class="px-card__tag px-card__tag--out">{{ 'content.product_badge_sold_out' | t }}</span>
                {%- elsif product.compare_at_price > product.price -%}
                  <span class="px-card__tag px-card__tag--sale">{{ 'content.product_badge_sale' | t }}</span>
                {%- endif -%}
              </span>
              <span class="px-card__info">
                <span class="px-card__name">{{ product.title }}</span>
                {%- if product.type != blank -%}
                  <span class="px-card__type">{{ product.type }}</span>
                {%- endif -%}
                <span class="px-card__row">
                  <span class="px-card__price">
                    {%- if product.compare_at_price > product.price -%}
                      <s class="px-card__cmp">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                    <b class="px-card__now">{{ product.price | money }}</b>
                  </span>
                  <span class="px-card__view">VIEW</span>
                </span>
              </span>
            </a>
          </li>
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll
      %}
    {% endpaginate %}
  </div>
</results-list>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
