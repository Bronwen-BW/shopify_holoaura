

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<style>
/* ============ 商品系列页 · 像素风皮肤（本 section 仅 collection 模板输出） ============ */
#shopify-section-section,
#shopify-section-main{
  --pxbg:#0d0b1a; --pxpanel:#1a1636; --pxpanel2:#221d47;
  --pxtext:#e8e6ff; --pxtext2:#9a94c7;
  --pxpink:#ff2e88; --pxcyan:#00f0ff; --pxgold:#ffd600;
  background:#0d0b1a;
  font-family:"VT323",ui-monospace,monospace;
}
#shopify-section-section .section-background,
#shopify-section-main .section-background,
#shopify-section-main results-list.product-grid-container,
#shopify-section-main .collection-wrapper{background:#0d0b1a !important;color:var(--pxtext);}
/* 全站去圆角 */
#shopify-section-section *,#shopify-section-main *{border-radius:0 !important;}

/* —— 顶部系列标题 / 描述 —— */
#shopify-section-section h1{
  font-family:"Press Start 2P",monospace !important;
  font-size:clamp(20px,3.2vw,34px) !important;line-height:1.35 !important;
  color:#fff !important;margin:0 0 14px;
  text-shadow:4px 4px 0 var(--pxpink),8px 8px 0 rgba(0,0,0,.5);
}
#shopify-section-section .section-field__rte,
#shopify-section-section p,
#shopify-section-section .rte{color:var(--pxtext2) !important;font-family:"VT323",monospace !important;font-size:20px !important;line-height:1.55 !important;}

/* —— 商品卡（复刻首页 .prod：4:5 卡牌、图铺满、hover 底部浮层） —— */
#shopify-section-main .product-grid__item{display:block;transition:transform .15s;}
#shopify-section-main .product-grid__item:hover{transform:translateY(-4px);}
.px-card{
  position:relative;display:block;width:100%;aspect-ratio:4/5;
  background:linear-gradient(160deg,#3a1f5e,#1a1437);
  border:3px solid #000;box-shadow:6px 6px 0 rgba(0,0,0,.5);
  overflow:hidden;text-decoration:none;color:#fff;
}
.px-card__media{position:absolute;inset:0;display:block;background:linear-gradient(160deg,#3a1f5e,#1a1437);}
.px-card__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s;}
.px-card:hover .px-card__media img{transform:scale(1.05);}
.px-card__ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:72px;filter:drop-shadow(3px 3px 0 rgba(0,0,0,.5));}
.px-card__tag{position:absolute;top:10px;left:10px;z-index:2;font-family:"Press Start 2P",monospace;font-size:9px;padding:5px 9px;color:#fff;border:2px solid #000;box-shadow:3px 3px 0 rgba(0,0,0,.45);letter-spacing:1px;}
.px-card__tag--sale{background:var(--pxgold);color:#1a1205;}
.px-card__tag--out{background:var(--pxpink);color:#fff;}
.px-card__info{
  position:absolute;left:0;right:0;bottom:0;z-index:3;padding:40px 14px 14px;
  display:flex;flex-direction:column;gap:6px;
  background:linear-gradient(180deg,rgba(10,8,25,0),rgba(10,8,25,.92) 35%);
  transform:translateY(100%);transition:transform .28s;
}
.px-card:hover .px-card__info,.px-card:focus-within .px-card__info{transform:translateY(0);}
.px-card__name{font-family:"VT323",monospace;font-size:18px;font-weight:bold;color:#fff;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.px-card__type{font-family:"VT323",monospace;font-size:14px;color:var(--pxtext2);}
.px-card__row{margin-top:6px;display:flex;justify-content:space-between;align-items:center;gap:8px;border-top:2px dashed #2e2656;padding-top:8px;}
.px-card__price{display:flex;flex-direction:column;gap:3px;line-height:1.2;min-width:0;}
.px-card__cmp{font-family:"Press Start 2P",monospace;font-size:9px;color:var(--pxtext2);text-decoration:line-through;}
.px-card__now{font-family:"Press Start 2P",monospace;font-size:13px;color:var(--pxgold);white-space:nowrap;}
.px-card__view{font-family:"Press Start 2P",monospace;font-size:10px;background:var(--pxpink);color:#fff;border:2px solid #000;padding:8px 12px;box-shadow:3px 3px 0 #7a0f44;white-space:nowrap;transition:background .12s,color .12s;}
.px-card:hover .px-card__view{background:var(--pxcyan);color:#001a1a;box-shadow:3px 3px 0 #007a8a;}
/* 触屏（无 hover）：信息常驻，保证标题价格可见 */
@media (hover:none){
  .px-card__info{transform:translateY(0);padding-top:32px;}
}
/* zoom-out 缩略视图：只留图块，占位符缩小 */
ul[product-grid-view="zoom-out"] .px-card__info,
ul[product-grid-view="zoom-out"] .px-card__tag{display:none;}
ul[product-grid-view="zoom-out"] .px-card__ph{font-size:34px;}
/* 快速加购 / 通用按钮 */
#shopify-section-main .button,
#shopify-section-main button.button,
#shopify-section-main .facets-toggle__button{
  font-family:"Press Start 2P",monospace !important;font-size:11px !important;
  border:2px solid #000 !important;box-shadow:4px 4px 0 rgba(0,0,0,.5) !important;
  text-transform:uppercase;letter-spacing:.5px;padding:12px 18px !important;
  transition:transform .1s, box-shadow .1s;
}
#shopify-section-main .button--primary,
#shopify-section-main .facets-toggle__button{background:var(--pxcyan) !important;color:#001a1a !important;}
#shopify-section-main .button--secondary{background:var(--pxpanel) !important;color:var(--pxgold) !important;}
#shopify-section-main .quick-add__button,
#shopify-section-main .quick-add button{background:var(--pxpink) !important;color:#fff !important;}
#shopify-section-main .button:hover,
#shopify-section-main .facets-toggle__button:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 rgba(0,0,0,.5) !important;}

/* —— 筛选 / 排序 —— */
#shopify-section-main .facets,
#shopify-section-main .facets *{color:var(--pxtext);}
#shopify-section-main .facets__filters-title,
#shopify-section-main .facets__heading,
#shopify-section-main .facets-vertical__heading,
#shopify-section-main .facets-drawer__title{
  font-family:"Press Start 2P",monospace !important;font-size:12px !important;color:var(--pxgold) !important;
}
#shopify-section-main .facets__clear-all-link{font-family:"Press Start 2P",monospace !important;font-size:9px !important;color:var(--pxcyan) !important;}
#shopify-section-main .facets-toggle__wrapper{border:2px solid #000 !important;}
#shopify-section-main .select__select,
#shopify-section-main select,
#shopify-section-main .facets__selected,
#shopify-section-main input[type="text"],
#shopify-section-main input[type="search"]{
  background:var(--pxpanel) !important;color:var(--pxtext) !important;
  border:2px solid #000 !important;border-radius:0 !important;
  font-family:"VT323",monospace !important;font-size:18px !important;
}
#shopify-section-main .facets-block-wrapper,
#shopify-section-main .facets--drawer{background:var(--pxpanel) !important;color:var(--pxtext);}

/* —— 空结果 —— */
#shopify-section-main .main-collection-grid__empty{
  background:var(--pxpanel) !important;border:3px solid #000 !important;
  box-shadow:6px 6px 0 rgba(0,0,0,.5) !important;color:var(--pxtext);
}
#shopify-section-main .main-collection-grid__empty-title{
  font-family:"Press Start 2P",monospace !important;color:#fff !important;
  text-shadow:3px 3px 0 var(--pxpink);
}
/* —— 分页 —— */
#shopify-section-main .pagination .button{background:var(--pxpanel) !important;color:var(--pxgold) !important;}
#shopify-section-main .pagination .button[aria-current="page"]{background:var(--pxpink) !important;color:#fff !important;}
/* 焦点 */
#shopify-section-main a:focus-visible,
#shopify-section-section a:focus-visible,
#shopify-section-main button:focus-visible{outline:3px solid var(--pxcyan) !important;outline-offset:2px;}
</style>

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
        {% for product in collection.products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            <a class="px-card{% if product.available == false %} is-soldout{% endif %}" href="{{ product.url }}">
              <span class="px-card__media">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 640 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  <span class="px-card__ph" aria-hidden="true">🎴</span>
                {%- endif -%}
                {%- if product.available == false -%}
                  <span class="px-card__tag px-card__tag--out">{{ 'content.product_badge_sold_out' | t }}</span>
                {%- elsif product.compare_at_price > product.price -%}
                  <span class="px-card__tag px-card__tag--sale">{{ 'content.product_badge_sale' | t }}</span>
                {%- endif -%}
              </span>
              <span class="px-card__info">
                <span class="px-card__name">{{ product.title }}</span>
                {%- if product.type != blank -%}
                  <span class="px-card__type">{{ product.type }}</span>
                {%- endif -%}
                <span class="px-card__row">
                  <span class="px-card__price">
                    {%- if product.compare_at_price > product.price -%}
                      <s class="px-card__cmp">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                    <b class="px-card__now">{{ product.price | money }}</b>
                  </span>
                  <span class="px-card__view">VIEW</span>
                </span>
              </span>
            </a>
          </li>
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll
      %}
    {% endpaginate %}
  </div>
</results-list>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
