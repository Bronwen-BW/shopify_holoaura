{% comment %}
  Scrydex — Category / Expansions page (matches scrydex.com/pokemon/expansions).
  Dark doc-style layout: left sidebar nav + main hero + logo grid.
  Data: Shopify collections (title / handle / products_count / image / published_at).
  Sidebar menu: pick a linklist in settings, otherwise fallback sample groups render.
  Release date override: collection.metafields.custom.release_date.
{% endcomment %}

{% assign source = section.settings.source_collection | default: collections.all %}

<style>
.sx-cats{
  --bg:#000; --surface:#0d0d0f; --surface2:#161618;
  --border:#1f1f23; --text:#ffffff; --text2:#9ca3af; --text3:#6b7280;
  --accent:#a855f7; --accent-soft:#c084fc; --red:#ee3a43;
  background:var(--bg); color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Inter,Helvetica,Arial,sans-serif;
  font-size:16px; line-height:1.5;
}
.sx-cats *,.sx-cats *::before,.sx-cats *::after{box-sizing:border-box}
.sx-cats a{color:inherit;text-decoration:none}
.sx-cats img{max-width:100%;display:block}

/* ── layout ── */
.sx-cats .sx-layout{display:grid;grid-template-columns:300px 1fr;min-height:100vh}
.sx-cats .sx-main{min-width:0}

/* ── sidebar ── */
.sx-cats .sx-sidebar{background:var(--surface);border-right:1px solid var(--border);padding:20px 0 40px;position:sticky;top:0;height:100vh;overflow-y:auto}
.sx-cats .sx-group-head{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;font-size:12px;font-weight:700;letter-spacing:.1em;color:var(--text);cursor:pointer;user-select:none}
.sx-cats .sx-group-head .sx-glyph{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;font-size:11px;margin-right:10px;flex:0 0 auto}
.sx-cats .sx-group-head .sx-caret{transition:transform .2s;font-size:10px;color:var(--text3)}
.sx-cats .sx-group.closed .sx-caret{transform:rotate(-90deg)}
.sx-cats .sx-group.closed .sx-children{display:none}
.sx-cats .sx-item{display:block;padding:7px 20px 7px 44px;color:var(--text2);font-size:14px;border-left:2px solid transparent;transition:background .12s,color .12s}
.sx-cats .sx-item:hover{color:var(--text);background:var(--surface2)}
.sx-cats .sx-item.active{color:var(--accent-soft);border-left-color:var(--accent);background:rgba(168,85,247,.08)}

/* ── hero ── */
.sx-cats .sx-hero{position:relative;overflow:hidden;padding:48px 40px 56px;border-bottom:1px solid var(--border)}
.sx-cats .sx-watermark{position:absolute;right:-10px;top:50%;transform:translateY(-50%);font-size:clamp(120px,20vw,300px);font-weight:900;color:rgba(255,255,255,.04);white-space:nowrap;pointer-events:none;letter-spacing:-.04em;line-height:1}
.sx-cats .sx-hero-inner{position:relative;z-index:1;max-width:760px}
.sx-cats .sx-hero-title-row{display:flex;align-items:center;gap:16px;margin-bottom:18px}
.sx-cats .sx-ball{width:42px;height:42px;border-radius:50%;background:linear-gradient(to bottom,var(--red) 0 50%,#fff 50% 100%);border:2px solid #000;position:relative;flex:0 0 auto;box-shadow:0 0 0 2px #2a2a2a}
.sx-cats .sx-ball::before{content:"";position:absolute;left:0;right:0;top:50%;height:7px;background:#000;transform:translateY(-50%)}
.sx-cats .sx-ball::after{content:"";position:absolute;top:50%;left:50%;width:13px;height:13px;background:#fff;border:3px solid #000;border-radius:50%;transform:translate(-50%,-50%)}
.sx-cats .sx-hero h1{font-size:26px;font-weight:800;margin:0;letter-spacing:.01em}
.sx-cats .sx-hero p{font-size:17px;color:var(--text2);margin:0;max-width:680px}

/* ── section ── */
.sx-cats .sx-section{padding:36px 40px 64px}
.sx-cats .sx-section-title{font-size:22px;font-weight:800;margin:0 0 28px;letter-spacing:.01em}

/* ── logo grid ── */
.sx-cats .sx-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:28px 20px}
.sx-cats .sx-tile{display:flex;flex-direction:column;align-items:center;text-align:center}
.sx-cats .sx-tile-logo{height:110px;width:100%;display:flex;align-items:center;justify-content:center}
.sx-cats .sx-tile-logo img{max-width:100%;max-height:100%;object-fit:contain;transition:opacity .15s}
.sx-cats .sx-tile:hover .sx-tile-logo img{opacity:.85}
.sx-cats .sx-tile-logo .sx-ph{font-size:44px;filter:grayscale(.2)}
.sx-cats .sx-tile-name{color:var(--text);font-size:14px;margin-top:14px;line-height:1.35;min-height:2.6em}
.sx-cats .sx-tile:hover .sx-tile-name{color:var(--accent-soft)}
.sx-cats .sx-tile-date{color:var(--text3);font-size:13px;margin-top:6px}

/* ── responsive ── */
@media (max-width:1100px){
  .sx-cats .sx-grid{grid-template-columns:repeat(4,1fr)}
}
@media (max-width:900px){
  .sx-cats .sx-layout{grid-template-columns:1fr}
  .sx-cats .sx-sidebar{position:relative;height:auto;border-right:0;border-bottom:1px solid var(--border)}
  .sx-cats .sx-grid{grid-template-columns:repeat(3,1fr)}
  .sx-cats .sx-hero,.sx-cats .sx-section{padding-left:20px;padding-right:20px}
}
@media (max-width:560px){
  .sx-cats .sx-grid{grid-template-columns:repeat(2,1fr);gap:24px 14px}
  .sx-cats .sx-tile-logo{height:80px}
}
</style>

<div class="sx-cats">
  <div class="sx-layout">

    <!-- ============ SIDEBAR ============ -->
    <aside class="sx-sidebar">
      {%- if section.settings.sidebar_menu -%}
        {%- for link in section.settings.sidebar_menu.links -%}
          <div class="sx-group">
            <div class="sx-group-head" data-sx-toggle>
              <span><span class="sx-glyph">▣</span>{{ link.title }}</span>
              <span class="sx-caret">▼</span>
            </div>
            {%- if link.links.size > 0 -%}
              <div class="sx-children">
                {%- for child in link.links -%}
                  <a class="sx-item {% if child.active %}active{% endif %}" href="{{ child.url }}">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {% comment %} Fallback sidebar matching the reference screenshot {% endcomment %}
        <div class="sx-group">
          <div class="sx-group-head" data-sx-toggle>
            <span><span class="sx-glyph" style="color:#ee3a43">◉</span>POKÉMON</span>
            <span class="sx-caret">▼</span>
          </div>
          <div class="sx-children">
            <a class="sx-item active" href="#">Latest English Expansions <span style="float:right">→</span></a>
            <a class="sx-item" href="#">30th Celebration</a>
            <a class="sx-item" href="#">30th Celebration: Classic C…</a>
            <a class="sx-item" href="#">Pitch Black</a>
            <a class="sx-item" href="#">Chaos Rising</a>
          </div>
        </div>
        <div class="sx-group">
          <div class="sx-group-head" data-sx-toggle>
            <span>&nbsp;</span>
          </div>
          <div class="sx-children">
            <a class="sx-item" href="#" style="padding-left:20px">Latest Japanese Expansions</a>
            <a class="sx-item" href="#">30th Celebration</a>
            <a class="sx-item" href="#">Storm Emerald</a>
            <a class="sx-item" href="#">Abyss Eye</a>
          </div>
        </div>
        <div class="sx-group">
          <div class="sx-group-head" data-sx-toggle>
            <span>&nbsp;</span>
          </div>
          <div class="sx-children">
            <a class="sx-item" href="#" style="padding-left:20px">Latest TCG Pocket Expansions</a>
            <a class="sx-item" href="#">Team Rocket's Ambition</a>
            <a class="sx-item" href="#">Everyday Wonders</a>
            <a class="sx-item" href="#">Pulsing Aura</a>
            <a class="sx-item" href="#" style="padding-left:20px">API Docs</a>
          </div>
        </div>
        <div class="sx-group">
          <div class="sx-group-head" data-sx-toggle>
            <span><span class="sx-glyph" style="color:#c084fc">◆</span>LORCANA</span>
            <span class="sx-caret">▼</span>
          </div>
          <div class="sx-children">
            <a class="sx-item" href="#" style="padding-left:20px">Latest Expansions</a>
            <a class="sx-item" href="#">Attack of the Vine!</a>
            <a class="sx-item" href="#">Wilds Unknown</a>
            <a class="sx-item" href="#">Winterspell</a>
            <a class="sx-item" href="#" style="padding-left:20px">API Docs</a>
          </div>
        </div>
        <div class="sx-group closed">
          <div class="sx-group-head" data-sx-toggle>
            <span><span class="sx-glyph" style="color:#60a5fa">✦</span>MAGIC: THE GATHERING</span>
            <span class="sx-caret">▼</span>
          </div>
        </div>
      {%- endif -%}
    </aside>

    <!-- ============ MAIN ============ -->
    <main class="sx-main">

      <!-- hero -->
      <section class="sx-hero">
        <div class="sx-watermark" aria-hidden="true">{{ section.settings.watermark_text | default: 'Pokémon' }}</div>
        <div class="sx-hero-inner">
          <div class="sx-hero-title-row">
            <span class="sx-ball" aria-hidden="true"></span>
            <h1>{{ section.settings.hero_title | default: 'Pokémon TCG' }}</h1>
          </div>
          <p>{{ section.settings.hero_description | default: "Catch 'em all. Explore every expansion in the Pokémon Trading Card Game, from the original Base Set to the latest releases." }}</p>
        </div>
      </section>

      <!-- logo grid -->
      <section class="sx-section">
        <h2 class="sx-section-title">{{ section.settings.section_title | default: 'Mega Evolution' }}</h2>
        <div class="sx-grid">
          {%- if source.size > 0 -%}
            {%- for collection in source -%}
              {%- assign rel_date = collection.metafields.custom.release_date | default: collection.published_at -%}
              <a class="sx-tile" href="{{ collection.url }}">
                <div class="sx-tile-logo">
                  {%- if collection.image -%}
                    <img src="{{ collection.image | image_url: width:400, height:240, crop:'center' }}" alt="{{ collection.title | escape }}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-block'">
                    <span class="sx-ph" style="display:none">🎴</span>
                  {%- else -%}
                    <span class="sx-ph">🎴</span>
                  {%- endif -%}
                </div>
                <div class="sx-tile-name">{{ collection.title }}</div>
                {%- if section.settings.show_date and rel_date -%}
                  <div class="sx-tile-date">{{ rel_date | date: '%Y/%m/%d' }}</div>
                {%- endif -%}
              </a>
            {%- endfor -%}
          {%- else -%}
            {% comment %} Fallback tiles matching the reference screenshot {% endcomment %}
            {% assign demo_tiles = "30th Celebration: Classic Collection|2026/09/16;30th Celebration|2026/09/16;Pitch Black|2026/07/17;Chaos Rising|2026/05/22;Perfect Order|2026/03/27;Ascended Heroes|2026/01/30;Phantasmal Flames|2025/11/14;Mega Evolution|2025/09/26;Mega Evolution Energies|2025/09/26;Mega Evolution Black Star Promos|2025/09/26" | split: ';' %}
            {%- for row in demo_tiles -%}
              {% assign parts = row | split: '|' %}
              <a class="sx-tile" href="#">
                <div class="sx-tile-logo"><span class="sx-ph">🎴</span></div>
                <div class="sx-tile-name">{{ parts[0] }}</div>
                {%- if section.settings.show_date -%}<div class="sx-tile-date">{{ parts[1] }}</div>{%- endif -%}
              </a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </section>

    </main>
  </div>
</div>

<script>
(function(){
  /* Sidebar collapse toggle */
  document.querySelectorAll('.sx-cats [data-sx-toggle]').forEach(function(head){
    head.addEventListener('click', function(){
      var g = head.parentElement;
      if (g) g.classList.toggle('closed');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Categories",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Pokémon TCG" },
    { "type": "textarea", "id": "hero_description", "label": "Hero description", "default": "Catch 'em all. Explore every expansion in the Pokémon Trading Card Game, from the original Base Set to the latest releases." },
    { "type": "text", "id": "watermark_text", "label": "Background watermark", "default": "Pokémon" },
    { "type": "header", "content": "Grid" },
    { "type": "text", "id": "section_title", "label": "Grid heading", "default": "Mega Evolution" },
    { "type": "collection", "id": "source_collection", "label": "Expansions source", "info": "Collections shown as logo tiles. Leave empty to list all collections." },
    { "type": "checkbox", "id": "show_date", "label": "Show release date", "default": true },
    { "type": "header", "content": "Sidebar" },
    { "type": "link_list", "id": "sidebar_menu", "label": "Sidebar menu", "info": "Top-level links = game groups; their nested links = expansion items. Leave empty for sample placeholder." }
  ],
  "presets": [
    { "name": "Categories" }
  ]
}
{% endschema %}
