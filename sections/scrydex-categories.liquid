{% comment %}
  Scrydex — Category / Expansions page.
  Layout from scrydex.com/pokemon/expansions (sidebar + hero + logo grid),
  visual style from scrydex-home.liquid (pixel / 8-bit, dark purple, hard shadows).
  Data: Shopify collections (title / image / published_at).
  Sidebar: pick a link_list in settings, otherwise sample fallback renders.
  Release date override: collection.metafields.custom.release_date.
{% endcomment %}

{% assign source = section.settings.source_collection | default: collections.all %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">

<style>
.sx-cats{
  --bg:#0d0b1a; --panel:#1a1636; --panel2:#221d47;
  --line:#2e2656; --line2:#3d3373;
  --text:#e8e6ff; --text2:#9a94c7; --text3:#5e5888;
  --pink:#ff2e88; --cyan:#00f0ff; --gold:#ffd600;
  --red:#ff4757; --purple:#b14aed;
  background:var(--bg); color:var(--text);
  font-family:"VT323",ui-monospace,monospace; font-size:18px; line-height:1.5;
}
.sx-cats *,.sx-cats *::before,.sx-cats *::after{box-sizing:border-box}
.sx-cats a{color:inherit;text-decoration:none}
.sx-cats img{max-width:100%;display:block}

/* ── layout ── */
.sx-cats .sx-layout{display:grid;grid-template-columns:280px 1fr;min-height:100vh}
.sx-cats .sx-main{min-width:0}

/* ── sidebar ── */
.sx-cats .sx-sidebar{background:var(--panel);border-right:3px solid #000;padding:24px 0 40px;position:sticky;top:0;height:100vh;overflow-y:auto}
.sx-cats .sx-group-head{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;font-family:"Press Start 2P",monospace;font-size:10px;letter-spacing:.05em;color:var(--gold);cursor:pointer;user-select:none;text-transform:uppercase}
.sx-cats .sx-group-head .sx-glyph{margin-right:10px;color:var(--pink)}
.sx-cats .sx-group-head .sx-caret{transition:transform .2s;font-size:9px;color:var(--text3)}
.sx-cats .sx-group.closed .sx-caret{transform:rotate(-90deg)}
.sx-cats .sx-group.closed .sx-children{display:none}
.sx-cats .sx-item{display:block;padding:7px 20px 7px 40px;color:var(--text2);font-size:17px;border-left:3px solid transparent;transition:background .12s,color .12s}
.sx-cats .sx-item:hover{color:var(--text);background:var(--panel2)}
.sx-cats .sx-item.active{color:var(--gold);border-left-color:var(--pink);background:rgba(255,46,136,.14)}

/* ── hero ── */
.sx-cats .sx-hero{position:relative;overflow:hidden;padding:56px 40px 48px;border-bottom:3px solid #000;background:radial-gradient(60% 80% at 25% 20%,rgba(177,74,237,.28),transparent 60%),radial-gradient(50% 70% at 85% 75%,rgba(255,46,136,.22),transparent 60%),linear-gradient(180deg,#1a1240,#0d0b1a)}
.sx-cats .sx-hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:32px 32px;pointer-events:none}
.sx-cats .sx-watermark{position:absolute;right:-10px;top:50%;transform:translateY(-50%);font-family:"Press Start 2P",monospace;font-size:clamp(80px,14vw,220px);font-weight:400;color:rgba(255,255,255,.04);white-space:nowrap;pointer-events:none;letter-spacing:0;line-height:1}
.sx-cats .sx-hero-inner{position:relative;z-index:1;max-width:780px}
.sx-cats .sx-hero-title-row{display:flex;align-items:center;gap:18px;margin-bottom:20px}
.sx-cats .sx-ball{width:46px;height:46px;border-radius:50%;background:linear-gradient(to bottom,var(--red) 0 50%,#fff 50% 100%);border:3px solid #000;position:relative;flex:0 0 auto;box-shadow:4px 4px 0 #000}
.sx-cats .sx-ball::before{content:"";position:absolute;left:0;right:0;top:50%;height:8px;background:#000;transform:translateY(-50%)}
.sx-cats .sx-ball::after{content:"";position:absolute;top:50%;left:50%;width:14px;height:14px;background:#fff;border:3px solid #000;border-radius:50%;transform:translate(-50%,-50%)}
.sx-cats .sx-hero h1{font-family:"Press Start 2P",monospace;font-size:clamp(18px,2.6vw,28px);line-height:1.3;margin:0;color:#fff;text-shadow:4px 4px 0 var(--pink),8px 8px 0 rgba(0,0,0,.5)}
.sx-cats .sx-hero h1 .c{color:var(--cyan)}
.sx-cats .sx-hero p{font-size:20px;color:var(--text2);margin:0;max-width:700px}
.sx-cats .sx-hero p b{color:var(--gold)}

/* ── section ── */
.sx-cats .sx-section{padding:40px 40px 64px}
.sx-cats .sx-section-title{font-family:"Press Start 2P",monospace;font-size:clamp(14px,2vw,18px);margin:0 0 28px;color:#fff;line-height:1.3}
.sx-cats .sx-section-title .blk{color:var(--pink)}

/* ── logo grid (pixel tiles) ── */
.sx-cats .sx-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:22px}
.sx-cats .sx-tile{background:var(--panel);border:3px solid #000;box-shadow:6px 6px 0 rgba(0,0,0,.5);padding:20px 14px;display:flex;flex-direction:column;align-items:center;text-align:center;transition:transform .15s}
.sx-cats .sx-tile:hover{transform:translateY(-4px)}
.sx-cats .sx-tile-logo{height:110px;width:100%;display:flex;align-items:center;justify-content:center;background:var(--panel2);border:2px solid #000;padding:8px}
.sx-cats .sx-tile-logo img{max-width:100%;max-height:100%;object-fit:contain;transition:transform .25s}
.sx-cats .sx-tile:hover .sx-tile-logo img{transform:scale(1.05)}
.sx-cats .sx-tile-logo .sx-ph{font-size:42px}
.sx-cats .sx-tile-name{font-family:"VT323",monospace;font-size:18px;font-weight:bold;color:#fff;margin-top:14px;line-height:1.3;min-height:2.6em}
.sx-cats .sx-tile:hover .sx-tile-name{color:var(--cyan)}
.sx-cats .sx-tile-date{display:inline-block;margin-top:8px;font-family:"Press Start 2P",monospace;font-size:9px;background:rgba(0,0,0,.6);padding:5px 8px;color:var(--gold)}

/* ── responsive ── */
@media (max-width:1100px){
  .sx-cats .sx-grid{grid-template-columns:repeat(4,1fr)}
}
@media (max-width:900px){
  .sx-cats .sx-layout{grid-template-columns:1fr}
  .sx-cats .sx-sidebar{position:relative;height:auto;border-right:0;border-bottom:3px solid #000}
  .sx-cats .sx-grid{grid-template-columns:repeat(3,1fr)}
  .sx-cats .sx-hero,.sx-cats .sx-section{padding-left:20px;padding-right:20px}
}
@media (max-width:560px){
  .sx-cats .sx-grid{grid-template-columns:repeat(2,1fr);gap:16px}
  .sx-cats .sx-tile-logo{height:80px}
  .sx-cats .sx-tile-name{font-size:16px}
}
</style>

<div class="sx-cats">
  <div class="sx-layout">

    <!-- ============ SIDEBAR ============ -->
    <aside class="sx-sidebar">
      {%- if section.settings.sidebar_menu -%}
        {%- for link in section.settings.sidebar_menu.links -%}
          <div class="sx-group">
            <div class="sx-group-head" data-sx-toggle>
              <span><span class="sx-glyph">▣</span>{{ link.title }}</span>
              <span class="sx-caret">▼</span>
            </div>
            {%- if link.links.size > 0 -%}
              <div class="sx-children">
                {%- for child in link.links -%}
                  <a class="sx-item {% if child.active %}active{% endif %}" href="{{ child.url }}">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {% comment %} Auto-list every collection so the sidebar is never incomplete {% endcomment %}
        <div class="sx-group">
          <div class="sx-group-head" data-sx-toggle>
            <span><span class="sx-glyph" style="color:var(--red)">◉</span>{{ section.settings.sidebar_title | default: 'EXPANSIONS' }}</span>
            <span class="sx-caret">▼</span>
          </div>
          <div class="sx-children">
            {%- for collection in collections.all -%}
              <a class="sx-item {% if request.path == collection.url %}active{% endif %}" href="{{ collection.url }}">{{ collection.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </aside>

    <!-- ============ MAIN ============ -->
    <main class="sx-main">

      <!-- hero -->
      <section class="sx-hero">
        <div class="sx-watermark" aria-hidden="true">{{ section.settings.watermark_text | default: 'Pokémon' }}</div>
        <div class="sx-hero-inner">
          <div class="sx-hero-title-row">
            <span class="sx-ball" aria-hidden="true"></span>
            <h1>{{ section.settings.hero_title | default: 'Pokémon TCG' }}</h1>
          </div>
          <p>{{ section.settings.hero_description | default: "Catch 'em all. Explore every expansion in the Pokémon Trading Card Game, from the original Base Set to the latest releases." }}</p>
        </div>
      </section>

      <!-- logo grid -->
      <section class="sx-section">
        <h2 class="sx-section-title">{{ section.settings.section_title | default: 'MEGA EVOLUTION' }}</h2>
        <div class="sx-grid">
          {%- if source.size > 0 -%}
            {%- for collection in source -%}
              {%- assign rel_date = collection.metafields.custom.release_date | default: collection.published_at -%}
              <a class="sx-tile" href="{{ collection.url }}">
                <div class="sx-tile-logo">
                  {%- if collection.image -%}
                    <img src="{{ collection.image | image_url: width:400, height:240, crop:'center' }}" alt="{{ collection.title | escape }}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-block'">
                    <span class="sx-ph" style="display:none">🎴</span>
                  {%- else -%}
                    <span class="sx-ph">🎴</span>
                  {%- endif -%}
                </div>
                <div class="sx-tile-name">{{ collection.title }}</div>
                {%- if section.settings.show_date and rel_date -%}
                  <div class="sx-tile-date">{{ rel_date | date: '%Y/%m/%d' }}</div>
                {%- endif -%}
              </a>
            {%- endfor -%}
          {%- else -%}
            {% comment %} Fallback tiles matching the reference screenshot {% endcomment %}
            {% assign demo_tiles = "30th Celebration: Classic Collection|2026/09/16;30th Celebration|2026/09/16;Pitch Black|2026/07/17;Chaos Rising|2026/05/22;Perfect Order|2026/03/27;Ascended Heroes|2026/01/30;Phantasmal Flames|2025/11/14;Mega Evolution|2025/09/26;Mega Evolution Energies|2025/09/26;Mega Evolution Black Star Promos|2025/09/26" | split: ';' %}
            {%- for row in demo_tiles -%}
              {% assign parts = row | split: '|' %}
              <a class="sx-tile" href="#">
                <div class="sx-tile-logo"><span class="sx-ph">🎴</span></div>
                <div class="sx-tile-name">{{ parts[0] }}</div>
                {%- if section.settings.show_date -%}<div class="sx-tile-date">{{ parts[1] }}</div>{%- endif -%}
              </a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </section>

    </main>
  </div>
</div>

<script>
(function(){
  /* Sidebar collapse toggle */
  document.querySelectorAll('.sx-cats [data-sx-toggle]').forEach(function(head){
    head.addEventListener('click', function(){
      var g = head.parentElement;
      if (g) g.classList.toggle('closed');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Categories",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Pokémon TCG" },
    { "type": "textarea", "id": "hero_description", "label": "Hero description", "default": "Catch 'em all. Explore every expansion in the Pokémon Trading Card Game, from the original Base Set to the latest releases." },
    { "type": "text", "id": "watermark_text", "label": "Background watermark", "default": "Pokémon" },
    { "type": "header", "content": "Grid" },
    { "type": "text", "id": "section_title", "label": "Grid heading", "default": "MEGA EVOLUTION" },
    { "type": "collection", "id": "source_collection", "label": "Expansions source", "info": "Collections shown as logo tiles. Leave empty to list all collections." },
    { "type": "checkbox", "id": "show_date", "label": "Show release date", "default": true },
    { "type": "header", "content": "Sidebar" },
    { "type": "text", "id": "sidebar_title", "label": "Sidebar heading (auto-list)", "default": "EXPANSIONS", "info": "Shown when no sidebar menu is picked." },
    { "type": "link_list", "id": "sidebar_menu", "label": "Sidebar menu", "info": "Optional. If set, uses this menu (top-level = game groups, nested links = items) instead of auto-listing all collections." }
  ],
  "presets": [
    { "name": "Categories" }
  ]
}
{% endschema %}
